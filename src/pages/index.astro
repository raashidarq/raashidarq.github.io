---
import OptimizedImage from '../components/OptimizedImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactBanner from '../components/ContactBanner.astro';
import {getCollection} from 'astro:content';
const projects=(await getCollection('projects')).filter(p=>p.data.featured&&p.data.status==='in-development').sort((a,b)=>a.data.order-b.data.order);
const notes=(await getCollection('notes')).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="Raashid Arquil — Independent Developer" description="Independent developer building websites and apps for businesses and people, and making my own products.">
<div class="shell">
<section class="home-intro">
<div><p class="eyebrow">Independent developer / From problem to product</p><h1 class="display">Websites and apps<br/><em class="serif">built to help.</em></h1><p class="lead">I'm Raashid. I build for businesses and people, and make my own products too. I start by understanding what's actually difficult, then build from there.</p><div class="hero-actions"><a class="button" href="/contact/">Start a project <span aria-hidden="true">→</span></a><a class="text-link" href="/work/">See what I've built</a></div><p class="hero-credentials"><span>First-Class Computer Science, Kingston University</span> · <span>Top 10, Ascentic AI Launchpad</span> · <span>Hackathon category winner</span></p></div>
<aside class="home-person"><OptimizedImage src="/images/profile.jpg" alt="Raashid Arquil" width="360" height="450" sizes="180px" fetchpriority="high" loading="eager"/><p>Currently building <a href="/products/keepclose/" target="_blank" rel="noopener">KeepClose</a>, <a href="/products/cropcare/" target="_blank" rel="noopener">CropCare</a>, and <a href="/products/tally/" target="_blank" rel="noopener">Tally</a>.</p></aside>
</section>
<section class="home-work" aria-labelledby="selected-work"><div class="section-heading"><div><p class="eyebrow mb-3">Selected work</p><h2 class="section-title" id="selected-work">What I'm building.</h2></div><a href="/work/" class="text-link">All work →</a></div><div class="home-project-grid">{projects.map(project=><ProjectCard project={project}/>)}</div></section>
<section class="section event-feature"><figure><OptimizedImage src="/images/launchpad-presenting.jpg" alt="Raashid presenting CropCare at the AI Launchpad event" width="2400" height="3600" loading="lazy"/><figcaption>AI Launchpad · TRACE, Sri Lanka</figcaption></figure><div><p class="eyebrow mb-4">Beyond the code</p><h2 class="section-title">Presenting CropCare<br/>at AI Launchpad.</h2><p class="lead mt-6">CropCare reached the Top 10 through Ascentic's AI Launchpad. Presenting at TRACE meant explaining the problem, the application, and the decisions behind it.</p><div class="event-links mt-6"><a class="text-link" href="/products/cropcare/#talk" target="_blank" rel="noopener">Watch the presentation (12 min) →</a><a class="text-link" href="/notes/problem-before-technology/">What I took from Launchpad →</a></div></div></section>
<section class="section"><div class="section-heading"><div><p class="eyebrow mb-3">Notes</p><h2 class="section-title">Along the way.</h2></div><a href="/notes/" class="text-link">All notes →</a></div><div class="home-note-grid">{notes.map(note=><a class="home-note" href={`/notes/${note.id}/`}><p class="eyebrow">{note.data.topic}{note.data.date&&` / ${new Date(note.data.date).toLocaleDateString('en-GB',{month:'short',year:'numeric'})}`}</p><h3>{note.data.title}</h3><p>{note.data.description}</p><span class="text-link">Read note →</span></a>)}</div></section>
<ContactBanner/>
</div></BaseLayout>
