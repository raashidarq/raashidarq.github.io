---
import OptimizedImage from '../components/OptimizedImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactBanner from '../components/ContactBanner.astro';
import {getCollection} from 'astro:content';
const projects=(await getCollection('projects')).filter(p=>p.data.featured).sort((a,b)=>a.data.order-b.data.order);
const notes=(await getCollection('notes')).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="Raashid Arquil — Software Engineer" description="Software engineer building independent products and web and mobile applications. Open to freelance projects and engineering roles.">
<div class="shell">
<section class="home-intro">
<div><p class="eyebrow">Independent work / Open to collaboration</p><h1 class="display">Raashid Arquil.<br/><em class="serif">Software engineer.</em></h1><p class="lead">I build web and mobile applications. My own products often start with a frustration I've experienced; I'm also open to freelance projects, starting with understanding yours.</p><div class="hero-actions"><a class="button" href="/work">Explore the work <span aria-hidden="true">↗</span></a><a class="text-link" href="/contact">Discuss a project ↗</a></div></div>
<aside class="home-person"><OptimizedImage src="/images/profile.jpg" alt="Raashid Arquil" width="360" height="450" sizes="180px" fetchpriority="high" loading="eager"/><p>Currently building <a href="/work/keepclose">KeepClose</a> and <a href="/work/cropcare">CropCare</a>.</p></aside>
</section>
<section class="home-work" aria-labelledby="selected-work"><div class="section-heading"><div><p class="eyebrow mb-3">Selected work</p><h2 class="section-title" id="selected-work">What I'm building.</h2></div><a href="/work" class="text-link">All work ↗</a></div><div class="home-project-grid">{projects.map(project=><ProjectCard project={project}/>)}</div></section>
<section class="section home-services"><div><p class="eyebrow mb-4">Working together</p><h2 class="section-title">Websites and applications<br/>for a defined need.</h2><a class="text-link mt-6" href="/services">Explore services ↗</a></div><div><p class="lead">A business website, a focused web application feature, or a mobile prototype. We'll agree on what needs to work, review the build, and plan the handover.</p><p class="small-copy mt-5">Open to freelance work and engineering roles. Get in touch to discuss scope and availability.</p></div></section>
<section class="section event-feature"><figure><OptimizedImage src="/images/launchpad-presenting.jpg" alt="Raashid presenting CropCare at the AI Launchpad event" width="2400" height="3600" loading="lazy"/><figcaption>AI Launchpad · TRACE, Sri Lanka</figcaption></figure><div><p class="eyebrow mb-4">Beyond the code</p><h2 class="section-title">Presenting CropCare<br/>at AI Launchpad.</h2><p class="lead mt-6">CropCare reached the Top 10 through Ascentic's AI Launchpad. Presenting at TRACE meant explaining the problem, the application, and the decisions behind it.</p><a class="text-link mt-6" href="/notes/problem-before-technology">What I took from Launchpad ↗</a></div></section>
<section class="section"><div class="section-heading"><div><p class="eyebrow mb-3">Notes</p><h2 class="section-title">Along the way.</h2></div><a href="/notes" class="text-link">All notes ↗</a></div><div class="home-note-grid">{notes.map(note=><a class="home-note" href={`/notes/${note.id}`}><p class="eyebrow">{note.data.topic} / Preview</p><h3>{note.data.title}</h3><p>{note.data.description}</p><span class="text-link">Read note ↗</span></a>)}</div></section>
<ContactBanner/>
</div></BaseLayout>
