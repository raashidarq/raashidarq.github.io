---
import BaseLayout from '../layouts/BaseLayout.astro';
const subject=encodeURIComponent('Project enquiry');
const body=encodeURIComponent('Hello Raashid,\n\nThe problem I would like to solve:\n\nWho it is for:\n\nWhat already exists:\n\nTiming and budget (if known):\n\n');
---
<BaseLayout title="Contact — Raashid Arquil" description="Discuss a software project, engineering opportunity, or collaboration with Raashid Arquil.">
<div class="shell">
<header class="page-intro compact-intro">
<p class="eyebrow">Contact / Start a conversation</p>
<h1 class="display">Let's talk.
</h1>
<p class="lead">A project, an engineering opportunity, or a conversation about something I'm building. You're welcome to get in touch.</p>
</header>
<section class="inquiry-grid">
<div>
<p class="eyebrow">The simplest way to reach me</p>
<a class="email-link" href="mailto:raashid.arq@gmail.com">raashid.arq@gmail.com</a>
<div class="copy-email-row"><button class="text-link" id="copy-email" type="button">Copy email address</button><span id="copy-status" role="status" aria-live="polite"></span></div>
<p class="lead">Open to freelance projects, remote engineering roles, and collaboration. Get in touch wherever you’re based.</p>
<a class="button mt-8" href={`mailto:raashid.arq@gmail.com?subject=${subject}&body=${body}`}>Write a project enquiry <span aria-hidden="true">↗</span>
</a>
<p class="text-xs text-fg-muted mt-4">Opens your email app. The prompts are optional; a short introduction is enough.</p>
<div class="footer-links mt-10">
<a class="text-link" href="https://linkedin.com/in/raashid-arquil" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
<a class="text-link" href="/resume.pdf">View resume ↗</a>
</div>
</div>
<div>
<p class="eyebrow mb-6">For a project, it helps to know</p>
<div class="inquiry-prompt">
<strong>The problem</strong>What is difficult today, and what would you like to change?</div>
<div class="inquiry-prompt">
<strong>The people</strong>Who will use the website or application?</div>
<div class="inquiry-prompt">
<strong>The starting point</strong>Do you already have designs, a website, or an existing system?</div>
<div class="inquiry-prompt">
<strong>The constraints</strong>Any timing or budget you have in mind. It's fine if you're still working these out.</div>
</div>
</section>
</div>
</BaseLayout>

<script>
const button=document.querySelector<HTMLButtonElement>('#copy-email');
button?.addEventListener('click',async()=>{const status=document.querySelector('#copy-status');try{await navigator.clipboard.writeText('raashid.arq@gmail.com');if(status)status.textContent='Email copied.';}catch{if(status)status.textContent='Select the email address above to copy it.';}});
</script>

<script>
const enquiry=document.querySelector<HTMLAnchorElement>('a[href^="mailto:"][href*="subject="]');
if(new URLSearchParams(location.search).get('topic')==='website'&&enquiry){
  const url=new URL(enquiry.href);url.searchParams.set('subject','Website enquiry');enquiry.href=url.href;enquiry.firstChild!.textContent='Write a website enquiry ';
}
</script>
