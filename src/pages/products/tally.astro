  <script>
  // Hero: link the window composition to scroll. --p runs 0 → 1 while the stage rises from
  // the bottom of the screen to a third of the way up; reduced motion keeps it at the end state.
  {
    const stage = document.querySelector<HTMLElement>('.tl-stage');
    if (stage && document.documentElement.classList.contains('tl-motion')) {
      let raf = 0;
      const set = () => {
        raf = 0;
        const r = stage.getBoundingClientRect();
        const vh = window.innerHeight;
        const p = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.62)));
        stage.style.setProperty('--p', p.toFixed(3));
      };
      const queue = () => { if (!raf) raf = requestAnimationFrame(set); };
      set();
      window.addEventListener('scroll', queue, { passive: true });
      window.addEventListener('resize', queue);
    }
  }

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Scroll reveals
    const revealables = document.querySelectorAll<HTMLElement>('.tl-rv, [data-merge]');
    if ('IntersectionObserver' in window && !reduce) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.12 });
      revealables.forEach((el) => io.observe(el));
    } else {
      revealables.forEach((el) => el.classList.add('is-in'));
    }

    // Tabs (ARIA tab pattern, automatic activation)
    document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const select = (tab: HTMLButtonElement, focus = true) => {
        for (const t of tabs) {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          const panel = document.getElementById(t.getAttribute('aria-controls')!)!;
          panel.hidden = !on;
          if (on && !reduce) panel.animate([{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }], { duration: 260, easing: 'ease-out' });
        }
        if (focus) tab.focus();
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(tab, false));
        tab.addEventListener('keydown', (e) => {
          let n = -1;
          if (e.key === 'ArrowRight') n = (i + 1) % tabs.length;
          else if (e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
          else if (e.key === 'Home') n = 0;
          else if (e.key === 'End') n = tabs.length - 1;
          if (n >= 0) { e.preventDefault(); select(tabs[n]); }
        });
      });
    });

    // Customise demo: feature switches, rearranging and theme
    const demo = document.querySelector<HTMLElement>('[data-demo]');
    if (demo) {
      const grid = demo.querySelector<HTMLElement>('[data-grid]')!;
      const mini = demo.querySelector<HTMLElement>('[data-mini]')!;
      const status = demo.querySelector<HTMLElement>('[data-mini-status]')!;
      const switches = [...demo.querySelectorAll<HTMLButtonElement>('[data-feature]')];
      const isOn = (id: string) => switches.find((s) => s.dataset.feature === id)?.getAttribute('aria-checked') === 'true';

      const flip = (change: () => void) => {
        const items = [...grid.children] as HTMLElement[];
        const before = new Map(items.map((el) => [el, el.getBoundingClientRect()]));
        change();
        if (reduce) return;
        for (const el of items) {
          if (el.hidden) continue;
          const a = before.get(el)!;
          const b = el.getBoundingClientRect();
          if (a.width === 0) { el.animate([{ opacity: 0, transform: 'scale(.96)' }, { opacity: 1, transform: 'none' }], { duration: 280, easing: 'ease-out' }); continue; }
          const dx = a.left - b.left, dy = a.top - b.top;
          if (dx || dy || a.width !== b.width) {
            el.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }], { duration: 380, easing: 'cubic-bezier(.2,.7,.2,1)' });
          }
        }
      };

      const apply = () => {
        for (const s of switches) {
          const req = s.dataset.requires;
          if (req) {
            const ok = isOn(req);
            s.disabled = !ok;
            if (!ok) s.setAttribute('aria-checked', 'false');
          }
        }
        grid.querySelectorAll<HTMLElement>('[data-w]').forEach((w) => {
          const f = w.dataset.w!;
          w.hidden = f !== 'core' && !isOn(f);
        });
        mini.querySelectorAll<HTMLElement>('[data-needs]').forEach((n) => {
          n.hidden = !n.dataset.needs!.split(' ').some(isOn);
        });
      };
      apply();

      switches.forEach((s) => s.addEventListener('click', () => {
        if (s.disabled) return;
        const next = s.getAttribute('aria-checked') !== 'true';
        flip(() => { s.setAttribute('aria-checked', String(next)); apply(); });
        const name = demo.querySelector(`label[for="${s.id}"]`)?.textContent;
        status.textContent = `${name} turned ${next ? 'on' : 'off'} in the preview.`;
      }));

      const orders = [
        ['core', 'tasks', 'energy', 'timer', 'habits', 'goals', 'eod', 'planner', 'energy-lg'],
        ['core', 'timer', 'habits', 'energy-lg', 'tasks', 'energy', 'planner', 'goals', 'eod'],
        ['core', 'energy-lg', 'tasks', 'timer', 'goals', 'eod', 'habits', 'energy', 'planner'],
      ];
      const all = [...grid.children] as HTMLElement[];
      const key = (el: HTMLElement) => (el.dataset.w === 'energy' && el.classList.contains('w-lg') ? 'energy-lg' : el.dataset.w!);
      let o = 0;
      demo.querySelector('[data-rearrange]')!.addEventListener('click', () => {
        o = (o + 1) % orders.length;
        flip(() => { for (const k of orders[o]) { const el = all.find((x) => key(x) === k); if (el) grid.appendChild(el); } });
        status.textContent = 'Widgets rearranged in the preview.';
      });

      demo.querySelectorAll<HTMLButtonElement>('[data-theme-set]').forEach((b) => b.addEventListener('click', () => {
        mini.dataset.theme = b.dataset.themeSet;
        demo.querySelectorAll('[data-theme-set]').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
      }));
    }

    // Command palette typing loop (only while visible, never with reduced motion)
    const pal = document.querySelector<HTMLElement>('[data-palette]');
    if (pal) {
      const typed = pal.querySelector<HTMLElement>('[data-typed]')!;
      const ph = pal.querySelector<HTMLElement>('[data-ph]')!;
      const items = [...pal.querySelectorAll<HTMLElement>('[data-results] li')];
      const word = 'journal';
      const render = (q: string) => {
        typed.textContent = q;
        ph.hidden = q.length > 0;
        let first = true;
        for (const li of items) {
          const show = q ? li.textContent!.toLowerCase().includes(q) || li.dataset.k!.includes(q) : li.dataset.k !== 'journal note' && li.textContent !== 'Open today’s journal';
          li.hidden = !show;
          li.classList.toggle('is-active', show && first);
          if (show) first = false;
        }
      };
      render(reduce ? 'journ' : '');
      if (!reduce && 'IntersectionObserver' in window) {
        let timer = 0, step = 0, visible = false;
        const tick = () => {
          if (!visible) return;
          step++;
          const n = step <= 2 ? 0 : Math.min(step - 2, word.length);
          render(word.slice(0, n));
          if (step > word.length + 9) step = 0;
          timer = window.setTimeout(tick, step <= 2 ? 600 : n === word.length ? 450 : 160);
        };
        new IntersectionObserver(([e]) => {
          visible = e.isIntersecting;
          window.clearTimeout(timer);
          if (visible) tick();
        }).observe(pal);
      }
    }
  </script>
