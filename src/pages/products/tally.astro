---
// Tally product page. Standalone: owns its header, <main>, type and motion.
// Every claim is grounded in the Tally repo (F:\Projects\prod) and src/content/projects/tally.md.
import ProductShell from '../../layouts/ProductShell.astro';
import '../../styles/products/tally.css';

const email = 'raashid.arq@gmail.com';
const notify = `mailto:${email}?subject=${encodeURIComponent('Tally: notify me')}&body=${encodeURIComponent('Hi Raashid, please let me know when Tally is released.')}`;
const img = (name: string, small: number, large: number) => ({
  src: `/products/tally/${name}-${large}.webp`,
  srcset: `/products/tally/${name}-${small}.webp ${small}w, /products/tally/${name}-${large}.webp ${large}w`,
});

const hubs = [
  { name: 'Today', note: 'Now and next, priorities, routines, check-in, timer' },
  { name: 'Tasks', note: 'Inbox, list, week, board, projects, goals' },
  { name: 'Calendar', note: 'Planned and recorded time, day and week' },
  { name: 'Journal', note: 'Daily notes, linked notes, folders and tags' },
  { name: 'Insights', note: 'Overview, habits, time, goals, trends' },
];
const tools = ['To-do list', 'Calendar', 'Habit tracker', 'Notes and journal', 'Pomodoro timer', 'Mood log'];

const insightTabs = [
  { id: 'overview', label: 'Overview', title: 'Observations in plain language',
    body: 'Summary figures against the period before, and sentences like “Thursdays had the most recorded focus”, each with what it’s based on.',
    image: img('overview', 1000, 1600), alt: 'Tally Insights overview: focus, tasks done, routines kept and average mood, above a list of plain-language observations' },
  { id: 'habits', label: 'Habits', title: 'Which routines actually stick',
    body: 'Every routine’s last 30 days at a glance, with kept, missed, paused and rest days told apart, and a year-long heatmap below.',
    image: img('habits', 1000, 1600), alt: 'Tally Insights habits view with a 30-day strip per routine and a yearly completion heatmap' },
  { id: 'time', label: 'Time', title: 'Where your focus went',
    body: 'Focus totals, sessions, your average and your busiest day, with a per-day breakdown you can filter by tag and project.',
    image: img('time', 1000, 1600), alt: 'Tally Insights time report with focus totals and a per-day table of sessions and focus time' },
  { id: 'trends', label: 'Trends', title: 'Your peak hours',
    body: 'Focus, energy, mood and motivation averaged by hour of the day. The hours where you tend to be at your best are shaded on the day timeline.',
    image: img('by-hour', 1000, 1600), alt: 'Tally Trends by hour: a focus-by-hour bar chart and energy, mood and motivation lines across the day' },
];

const features = [
  { id: 'tasks', name: 'Tasks', desc: 'To-dos with quick add, projects, subtasks and repeats.', on: true },
  { id: 'habits', name: 'Habits', desc: 'Daily habits with flexible schedules, targets and rest days.', on: true },
  { id: 'timer', name: 'Focus timer', desc: 'Pomodoro and stopwatch sessions, logged automatically.', on: true },
  { id: 'energy', name: 'Energy and mood', desc: 'Quick check-ins, and how they move through the day.', on: true },
  { id: 'eod', name: 'Journal', desc: 'Daily notes, linked notes and an evening review.', on: true },
  { id: 'goals', name: 'Weekly goals', desc: 'Goals for the day, week, quarter, year and long term, with tasks linked to them.', on: false },
  { id: 'planner', name: 'Planner', desc: 'Plan my day: goals for the day, breaks, time blocks and a workload bar.', on: false, requires: 'tasks' },
  { id: 'analytics', name: 'Analytics', desc: 'Observations and trends across what you track.', on: true },
];

const moreCustom = [
  'Widget sizes: small, medium or large',
  'Your own task statuses, which become the board’s columns',
  'Journal prompts, prompt groups and your daily template',
  'Parts of your day, for routine time windows',
  'Every keyboard shortcut, rebindable',
  'Pomodoro lengths and cycles',
  'Daily capacity for the workload bar',
  'Reminder times for Plan my day, the Daily review and the Weekly review',
  'Week start and date format',
  'Light, dark or follow the system',
];

const tiles: { title: string; body: string; kbd?: string }[] = [
  { title: 'Lives in the tray', body: 'Start or stop focus, log energy or open quick capture from the tray. Its tooltip shows the focus time left.' },
  { title: 'Undo, not “Are you sure?”', body: 'Changes apply instantly, and anything reversible comes with an Undo instead of a confirmation dialog.' },
  { title: 'Rituals for the day and week', body: 'Optional guided steps: plan your day in the morning, review it in the evening, review the week.' },
  { title: 'Backups, a trash and export', body: 'Automatic backups, a trash for deleted items, and export to CSV, Markdown and JSON.' },
];

const faq = [
  { q: 'Is Tally just a to-do app?', a: 'No. Tasks are one part. Tally also has a calendar of planned and recorded time, habits, a journal with notes, a focus timer, energy and mood check-ins, goals, and insights that compare them all.' },
  { q: 'Do I need an account?', a: 'No. There’s no sign-up. Everything is stored on your computer, and the app blocks external connections.' },
  { q: 'Does it sync to my phone?', a: 'No. Tally is a desktop app for Windows, macOS and Linux, and there’s no mobile app or sync service. Two windows on the same computer stay in sync.' },
  { q: 'Can I turn off the parts I don’t use?', a: 'Yes. Each feature can be turned off in Settings. Turning one off hides it everywhere, and its data is kept in case you turn it back on.' },
  { q: 'Can I get my data out?', a: 'Yes. There are backups and a trash, and you can export to CSV, Markdown and JSON.' },
  { q: 'When can I try it?', a: 'Tally is in development, with a first public release coming next. Ask to be notified and you’ll hear when it’s out.' },
];
---
<ProductShell
  title="Tally: one desktop app for the whole day"
  description="Tasks, calendar, habits, journal, focus and insights in one local-first desktop app for Windows, macOS and Linux. No account, works offline. In development."
  slug="tally"
  themeColor="#fbfbfa"
  scheme="light"
  bodyClass="tl"
  fonts="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400;500&display=swap"
>
  <script is:inline slot="head">document.documentElement.classList.add('tl-js');if(!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('tl-motion');</script>

  <header class="tl-header">
    <div class="tl-wrap tl-header-row">
      <a class="tl-brand" href="#main" aria-label="Tally, back to top">
        <img src="/products/tally/logo.svg" alt="" width="99" height="32" />
      </a>
      <nav class="tl-nav" aria-label="Tally page">
        <a href="#system">One system</a>
        <a href="#views">Features</a>
        <a href="#insights">Insights</a>
        <a href="#customise">Customise</a>
        <a href="#status">Status</a>
        <a href="#faq">FAQ</a>
      </nav>
      <a class="tl-btn tl-btn-sm" href={notify}>Get notified</a>
    </div>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="tl-hero" aria-labelledby="tl-title">
      <div class="tl-wrap tl-hero-copy">
        <h1 id="tl-title" class="tl-h1">One app for <span class="tl-nowrap">the whole day.</span></h1>
        <p class="tl-lede">Tasks, calendar, habits, a journal and a focus timer in one desktop app. They’re connected, so Tally can show you how your days actually go. Switch on only the parts you need.</p>
        <div class="tl-ctas">
          <a class="tl-btn" href={notify}>Get notified</a>
          <a class="tl-btn tl-btn-ghost" href="#system">See how it fits together</a>
        </div>
        <ul class="tl-facts" aria-label="At a glance">
          <li>Windows, macOS and Linux</li><li>No account</li><li>Works offline</li>
        </ul>
      </div>
      <div class="tl-wrap">
        <div class="tl-stage">
          <figure class="tl-win tl-win-main">
            <picture>
              <source media="(max-width: 600px)" srcset="/products/tally/today-m-700.webp 700w, /products/tally/today-m-1200.webp 1200w" sizes="94vw" width="1200" height="643" />
              <img src={img('today', 1000, 2000).src} srcset={img('today', 1000, 2000).srcset} sizes="(min-width: 1200px) 1120px, 94vw"
                width="2000" height="1250" fetchpriority="high"
                alt="Tally's Today view: what's on now and next, today's priorities, an energy, mood and motivation check-in, routines and a running focus timer" />
            </picture>
          </figure>
          <figure class="tl-win tl-float tl-float-capture">
            <img src="/products/tally/capture-1040.webp" srcset="/products/tally/capture-520.webp 520w, /products/tally/capture-1040.webp 1040w" sizes="(min-width: 900px) 420px, 60vw"
              width="1040" height="270" alt="Quick capture window: the text 'Draft pricing FAQ fri 10am !high #launch' parsed into Fri, 10am, High priority and #launch" />
            <figcaption>Quick capture <kbd>Ctrl</kbd><kbd>Shift</kbd><kbd>Space</kbd></figcaption>
          </figure>
          <figure class="tl-win tl-float tl-float-timer">
            <img src="/products/tally/mini-timer-680.webp" srcset="/products/tally/mini-timer-340.webp 340w, /products/tally/mini-timer-680.webp 680w" sizes="300px"
              width="680" height="192" alt="Mini timer window showing 12:10 left in a focus session, with pause and stop buttons" />
            <figcaption>Mini timer, above other apps</figcaption>
          </figure>
        </div>
        <p class="tl-note">Screens from a development build, with fictional demo data.</p>
      </div>
    </section>

    <!-- One system -->
    <section id="system" class="tl-section tl-system" aria-labelledby="tl-system-title">
      <div class="tl-wrap">
        <div class="tl-head tl-rv">
          <p class="tl-eyebrow">One system</p>
          <h2 id="tl-system-title" class="tl-h2">Stop running your day across five apps.</h2>
          <p class="tl-sub">A list here, a calendar there, a habit tracker, a notes app and a timer. Each one sees a slice of your day. Tally puts them in five places in one window, so they can finally see each other.</p>
        </div>

        <div class="tl-merge tl-rv" data-merge>
          <ul class="tl-merge-tools" aria-label="The apps Tally replaces">
            {tools.map((t, i) => <li style={`--i:${i}`}>{t}</li>)}
          </ul>
          <svg class="tl-merge-lines" viewBox="0 0 200 360" preserveAspectRatio="none" aria-hidden="true">
            {[30, 90, 150, 210, 270, 330].map((y, i) => (
              <path style={`--i:${i}`} d={`M0 ${y} C 110 ${y}, 90 180, 200 180`} pathLength="1" />
            ))}
          </svg>
          <div class="tl-merge-app" role="group" aria-label="Tally's five places">
            <div class="tl-merge-bar"><img src="/products/tally/logo.svg" alt="Tally" width="74" height="24" /></div>
            <ul>
              {hubs.map((h, i) => (
                <li style={`--i:${i}`} class={i === 0 ? 'is-on' : ''}><strong>{h.name}</strong><span>{h.note}</span></li>
              ))}
            </ul>
          </div>
        </div>

        <div class="tl-links">
          <article class="tl-link tl-rv">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2M9 2h6"/></svg>
            <h3>Focus logs itself</h3>
            <p>Start a session on a task or a habit, and the time is recorded against it and shows up in your calendar.</p>
          </article>
          <article class="tl-link tl-rv">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h12v18H6a2 2 0 0 1-2-2z"/><path d="M8 8h6M8 12h6"/></svg>
            <h3>The journal knows your day</h3>
            <p>Each daily note shows what you finished, how long you focused and which routines you kept, next to your mood and sleep.</p>
          </article>
          <article class="tl-link tl-rv">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/></svg>
            <h3>Goals connect to the work</h3>
            <p>Link tasks and projects to a goal, and Insights shows how much of your focus actually went towards it.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Views -->
    <section id="views" class="tl-section tl-views" aria-labelledby="tl-views-title">
      <div class="tl-wrap">
        <div class="tl-head tl-rv">
          <p class="tl-eyebrow">Everything in it</p>
          <h2 id="tl-views-title" class="tl-h2">Each part of the day gets a proper view.</h2>
        </div>

        <!-- Tasks -->
        <article class="tl-feature" aria-labelledby="f-tasks">
          <div class="tl-feature-copy tl-rv">
            <p class="tl-view">Tasks <span>Inbox · All · Week · Board · Projects</span></p>
            <h3 id="f-tasks" class="tl-h3">Write it the way you’d say it.</h3>
            <p>Type <code>Draft pricing FAQ fri 10am !high #launch</code> and Tally picks out the day, the time, the priority and the tag. Then see your tasks as a list, by week, or on a board.</p>
            <ul class="tl-points">
              <li>Quick capture from any app: <span class="tl-kbds"><kbd>Ctrl</kbd><kbd>Shift</kbd><kbd>Space</kbd></span>, type, Enter.</li>
              <li>Name your own workflow statuses. They become the board’s columns.</li>
              <li>Projects, subtasks, estimates and repeating tasks.</li>
              <li>Unfinished tasks come back for a quick review each morning.</li>
            </ul>
          </div>
          <div class="tl-feature-art tl-rv">
            <figure class="tl-win tl-win-crop">
              <img src={img('board', 700, 1200).src} srcset={img('board', 700, 1200).srcset} sizes="(min-width: 960px) 560px, 92vw"
                width="1200" height="918" loading="lazy" decoding="async"
                alt="Tally task board with Not started and In progress columns; each card shows its due day, estimate, tag and project" />
            </figure>
            <figure class="tl-win tl-float tl-art-capture">
              <img src="/products/tally/capture-1040.webp" srcset="/products/tally/capture-520.webp 520w, /products/tally/capture-1040.webp 1040w" sizes="360px"
                width="1040" height="270" loading="lazy" decoding="async" alt="" />
            </figure>
          </div>
        </article>

        <!-- Calendar -->
        <article class="tl-feature tl-flip" aria-labelledby="f-cal">
          <div class="tl-feature-copy tl-rv">
            <p class="tl-view">Calendar <span>Day · Week · Log</span></p>
            <h3 id="f-cal" class="tl-h3">What you planned, next to what really happened.</h3>
            <p>Plan time blocks and breaks on the left. Your focus sessions fill in on the right as you work, beside lanes for energy, mood and habits, so a day you can look back on is a day you can learn from.</p>
            <ul class="tl-points">
              <li>Recorded time comes straight from the focus timer.</li>
              <li>A workload bar weighs the day’s tasks against your capacity, and says when you’ll likely finish.</li>
              <li>Planning is optional: turn on Planner when you want time blocks.</li>
            </ul>
          </div>
          <div class="tl-feature-art tl-rv">
            <figure class="tl-win tl-win-crop">
              <img src={img('calendar-grid', 800, 1400).src} srcset={img('calendar-grid', 800, 1400).srcset} sizes="(min-width: 960px) 640px, 92vw"
                width="1400" height="729" loading="lazy" decoding="async"
                alt="Tally calendar Day view for Tuesday, Oct 13: planned blocks such as Deep work 9 to 11am in one column, the focus sessions actually recorded in the next, and energy, mood and habit lanes beside them" />
            </figure>
            <figure class="tl-win tl-float tl-art-workload">
              <img src="/products/tally/calendar-workload-570.webp" srcset="/products/tally/calendar-workload-360.webp 360w, /products/tally/calendar-workload-570.webp 570w" sizes="300px"
                width="570" height="236" loading="lazy" decoding="async"
                alt="The day's workload card: 6h 27m of 5h 30m, about 57m more than your usual day. Focused 2h 57m, 3h 30m to go, finishing around 5:55pm at this pace." />
            </figure>
          </div>
        </article>

        <!-- Habits -->
        <article class="tl-feature" aria-labelledby="f-habits">
          <div class="tl-feature-copy tl-rv">
            <p class="tl-view">Habits <span>Routines</span></p>
            <h3 id="f-habits" class="tl-h3">Habits that fit real weeks.</h3>
            <p>Not every habit is daily. Set a schedule, a target like 20 pages or 8 glasses, and rest days, and Tally only counts the days that were actually due.</p>
            <ul class="tl-points">
              <li>Check routines off from Today, or start a focus session on one.</li>
              <li>Give a routine a time window and your own tips or checklist.</li>
              <li>A 30-day strip for every routine and a year-long heatmap.</li>
            </ul>
          </div>
          <div class="tl-feature-art tl-rv">
            <figure class="tl-win tl-win-crop">
              <img src={img('habits-crop', 800, 1300).src} srcset={img('habits-crop', 800, 1300).srcset} sizes="(min-width: 960px) 640px, 92vw"
                width="1300" height="630" loading="lazy" decoding="async"
                alt="Tally habit history: six routines with 30-day strips of kept and missed days, and a yearly heatmap" />
            </figure>
          </div>
        </article>

        <!-- Journal -->
        <article class="tl-feature tl-flip" aria-labelledby="f-journal">
          <div class="tl-feature-copy tl-rv">
            <p class="tl-view">Journal <span>Daily notes · Notes</span></p>
            <h3 id="f-journal" class="tl-h3">A page for every day, and notes that link up.</h3>
            <p>One page per day from your own template, with mood and sleep at the top and what you did that day a click away. Alongside it, notes with their own titles, linked with <code>[[double brackets]]</code>.</p>
            <ul class="tl-points">
              <li>A full editor: headings, lists, checklists, quotes, tables and code.</li>
              <li>Prompt groups, bookmarks, open tabs, folders and tags.</li>
              <li>An evening review: mood, sleep and one question.</li>
            </ul>
          </div>
          <div class="tl-feature-art tl-rv">
            <figure class="tl-win tl-win-crop">
              <img src={img('journal-crop', 800, 1400).src} srcset={img('journal-crop', 800, 1400).srcset} sizes="(min-width: 960px) 620px, 92vw"
                width="1400" height="1050" loading="lazy" decoding="async"
                alt="Tally journal: open notes and note folders on the left, and today's daily note with mood, sleep, a tag, an intention, notes, a checklist, a quote and an evening review" />
            </figure>
          </div>
        </article>

        <!-- Focus -->
        <article class="tl-feature" aria-labelledby="f-focus">
          <div class="tl-feature-copy tl-rv">
            <p class="tl-view">Focus and goals <span>Pomodoro · Stopwatch · Week · Quarter · Year</span></p>
            <h3 id="f-focus" class="tl-h3">Focus that adds up to something.</h3>
            <p>Start a pomodoro or a stopwatch on a task or habit, and the session is logged for you. Link tasks and projects to goals for the week, quarter or year, and see how far each one has come.</p>
            <ul class="tl-points">
              <li>Set your own focus and break lengths, and cycles before a long break.</li>
              <li>Pop the timer out into a mini window, or run it from the tray.</li>
              <li>Goals nest: a weekly goal can be part of a quarterly one.</li>
            </ul>
          </div>
          <div class="tl-feature-art tl-rv">
            <figure class="tl-win tl-win-crop">
              <img src={img('goals', 700, 1200).src} srcset={img('goals', 700, 1200).srcset} sizes="(min-width: 960px) 600px, 92vw"
                width="1200" height="555" loading="lazy" decoding="async"
                alt="Tally goals by horizon: a weekly goal that is part of a quarterly goal, with its goals for the day, linked project and tasks, and progress such as 11 of 19 tasks done" />
            </figure>
            <figure class="tl-win tl-float tl-art-timer">
              <img src="/products/tally/mini-timer-680.webp" srcset="/products/tally/mini-timer-340.webp 340w, /products/tally/mini-timer-680.webp 680w" sizes="300px"
                width="680" height="192" loading="lazy" decoding="async" alt="The mini timer window, 12:10 left in a focus session" />
            </figure>
          </div>
        </article>
      </div>
    </section>

    <!-- Insights tabs -->
    <section id="insights" class="tl-section tl-insights" aria-labelledby="tl-insights-title">
      <div class="tl-wrap">
        <div class="tl-head tl-rv">
          <p class="tl-eyebrow">Insights</p>
          <h2 id="tl-insights-title" class="tl-h2">Built around how you actually behave.</h2>
          <p class="tl-sub">Because your tasks, focus, habits, energy and mood live in one place, Tally can compare them. Insights turns them into figures and observations you can check, worked out on your own computer.</p>
        </div>
        <div class="tl-tabs tl-rv" data-tabs>
          <div class="tl-tablist" role="tablist" aria-label="Insights views">
            {insightTabs.map((t, i) => (
              <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.label}</button>
            ))}
          </div>
          {insightTabs.map((t, i) => (
            <div class="tl-panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
              <div class="tl-panel-copy">
                <h3>{t.title}</h3>
                <p>{t.body}</p>
              </div>
              <figure class="tl-win tl-win-crop">
                <img src={t.image.src} srcset={t.image.srcset} sizes="(min-width: 1200px) 1040px, 92vw" width="1600" height="867" loading="lazy" decoding="async" alt={t.alt} />
              </figure>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Customise -->
    <section id="customise" class="tl-section tl-custom" aria-labelledby="tl-custom-title">
      <div class="tl-wrap">
        <div class="tl-head tl-rv">
          <p class="tl-eyebrow">Make it yours</p>
          <h2 id="tl-custom-title" class="tl-h2">Shaped the way you work.</h2>
          <p class="tl-sub">Each part of Tally is a feature you can switch on or off. Today is a dashboard of widgets you arrange yourself. Try it below. Turning a feature off hides it, and never deletes its data.</p>
        </div>

        <div class="tl-demo tl-rv" data-demo>
          <div class="tl-demo-settings">
            <p class="tl-demo-label">Settings · Features</p>
            <ul>
              {features.map((f) => (
                <li>
                  <div>
                    <label for={`sw-${f.id}`}>{f.name}</label>{f.requires && <span class="tl-req-c" aria-hidden="true">Needs Tasks</span>}
                    <p id={`sw-${f.id}-d`}>{f.desc}{f.requires && <span class="tl-req"> Requires Tasks.</span>}</p>
                  </div>
                  <button type="button" role="switch" class="tl-switch" id={`sw-${f.id}`} data-feature={f.id} data-requires={f.requires}
                    aria-checked={f.on ? 'true' : 'false'} aria-describedby={`sw-${f.id}-d`}><span></span></button>
                </li>
              ))}
            </ul>
          </div>

          <div class="tl-demo-preview">
            <div class="tl-demo-tools">
              <button type="button" class="tl-chip-btn" data-rearrange>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4v16M3 8l4-4 4 4M17 20V4M13 16l4 4 4-4"/></svg>Rearrange widgets
              </button>
              <div class="tl-seg tl-seg-theme" role="radiogroup" aria-label="Preview theme">
                <button type="button" role="radio" aria-checked="true" data-theme-set="light">Light</button>
                <button type="button" role="radio" aria-checked="false" data-theme-set="dark">Dark</button>
              </div>
            </div>
            <div class="tl-mini" data-mini data-theme="light" aria-live="polite">
              <p class="tl-sr" data-mini-status></p>
              <aside class="tl-mini-side" aria-label="Sidebar in the preview">
                <span class="tl-mini-logo"><img class="lg-l" src="/products/tally/logo.svg" alt="" width="62" height="20" /><img class="lg-d" src="/products/tally/logo-dark.svg" alt="" width="62" height="20" loading="lazy" /></span>
                <span class="is-on">Today</span>
                <span data-needs="tasks">Tasks</span>
                <span data-needs="timer planner">Calendar</span>
                <span data-needs="eod">Journal</span>
