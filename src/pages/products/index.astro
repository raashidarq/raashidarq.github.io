---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactBanner from '../../components/ContactBanner.astro';

type Shot = { src: string; w: number; h: number; alt: string };
type Product = {
  slug: string; name: string; kind: string; status: string; line: string; problem: string;
  font: string; c: { bg: string; ink: string; muted: string; accent: string; onAccent: string; line: string };
  layout: 'window' | 'phones'; shots: Shot[];
};

const products: Product[] = [
  {
    slug: 'tally', name: 'Tally', kind: 'Desktop productivity', status: 'In development · Windows, macOS & Linux',
    line: 'One app for the whole day.',
    problem: 'Tasks, calendar, habits, a journal, focus and insights in one local-first desktop app, instead of five apps that never see each other.',
    font: "'Geist', system-ui, sans-serif",
    c: { bg: '#f1f7f3', ink: '#161a17', muted: '#4a524c', accent: '#1f7a4d', onAccent: '#ffffff', line: '#cfe0d5' },
    layout: 'window',
    shots: [{ src: '/products/tally/today-1000.webp', w: 1000, h: 625, alt: 'Tally’s Today dashboard with tasks, habits and a focus timer' }],
  },
  {
    slug: 'cropcare', name: 'CropCare', kind: 'Mobile · Agriculture', status: 'Working MVP · Top 10, Ascentic AI Launchpad',
    line: 'Photograph a plant. See what might be wrong.',
    problem: 'Possible pest and disease identification that works without signal, with guidance in English, Sinhala and Tamil, and an honest “not sure”.',
    font: "'Noto Sans Display', 'Noto Sans', system-ui, sans-serif",
    c: { bg: '#f1f5ef', ink: '#142016', muted: '#4a564b', accent: '#16531e', onAccent: '#ffffff', line: '#dce3d9' },
    layout: 'phones',
    shots: [
      { src: '/products/cropcare/shot-home.webp', w: 600, h: 1263, alt: 'CropCare home screen with a scan button' },
      { src: '/products/cropcare/shot-result.webp', w: 600, h: 1055, alt: 'CropCare result with a low-confidence warning' },
    ],
  },
  {
    slug: 'keepclose', name: 'KeepClose', kind: 'Mobile · Personal', status: 'In development · Android',
    line: 'Remember the people in your life.',
    problem: 'People, relationships and moments kept in an encrypted app with no Internet permission, which can explain how anyone is related to you.',
    font: "'Plus Jakarta Sans', system-ui, sans-serif",
    c: { bg: '#f6f0e4', ink: '#231f19', muted: '#5a5146', accent: '#2b6643', onAccent: '#ffffff', line: '#d8ccb7' },
    layout: 'phones',
    shots: [
      { src: '/products/keepclose/screen-profile.webp', w: 720, h: 1558, alt: 'A KeepClose profile with relationships and memories' },
      { src: '/products/keepclose/screen-family-tree.webp', w: 720, h: 1558, alt: 'The KeepClose family tree' },
    ],
  },
  {
    slug: 'smartdrive', name: 'SmartDrive', kind: 'Web · Business', status: 'Prototype · Live demo',
    line: 'The driving school, off the phone.',
    problem: 'Bookings, lessons and records in one system with a dashboard for students, instructors and the school’s admins.',
    font: "'Archivo', system-ui, sans-serif",
    c: { bg: '#eef1f4', ink: '#0f2236', muted: '#4c5c6d', accent: '#10243a', onAccent: '#ffffff', line: '#d3dae1' },
    layout: 'window',
    shots: [{ src: '/products/smartdrive/ui-student-880.webp', w: 880, h: 552, alt: 'The SmartDrive student dashboard' }],
  },
];

const fonts = 'https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Noto+Sans+Display:wght@700..800&family=Plus+Jakarta+Sans:wght@600..800&family=Archivo:wdth,wght@100..125,700..800&display=swap';
const vars = (p: Product) =>
  `--c-bg:${p.c.bg};--c-ink:${p.c.ink};--c-muted:${p.c.muted};--c-accent:${p.c.accent};--c-on-accent:${p.c.onAccent};--c-line:${p.c.line};--c-font:${p.font}`;
---
<BaseLayout
  title="Products — Raashid Arquil"
  description="Tally, CropCare, KeepClose and SmartDrive: software products by Raashid Arquil, each built around one real problem."
  defaultTheme="dark"
>
  <link slot="head" rel="stylesheet" href={fonts} />
  <div class="shell">
    <header class="page-intro compact-intro">
      <p class="eyebrow">Products</p>
      <h1 class="display">Four products,<br/><em class="serif">each built around one real problem.</em></h1>
      <p class="lead">I design and build them myself, from research to tested code. Each product page says plainly what works today and what’s still to come.</p>
    </header>

    <ul class="pi-list" aria-label="All products">
      {products.map((p, i) => (
        <li class="pi-item" style={vars(p)}>
          <a class:list={['pi-card', `is-${p.layout}`]} href={`/products/${p.slug}/`} target="_blank" rel="noopener" aria-label={`${p.name}: ${p.line} (opens in a new tab)`}>
            <div class="pi-copy">
              <p class="pi-kind"><span>{String(i + 1).padStart(2, '0')}</span>{p.kind}</p>
              <h2 class="pi-name">{p.name}</h2>
              <p class="pi-line">{p.line}</p>
              <p class="pi-problem">{p.problem}</p>
              <p class="pi-status">{p.status}</p>
              <span class="pi-go" aria-hidden="true">View the product page <span class="pi-arrow">↗</span></span>
            </div>
            <div class="pi-art" aria-hidden="true">
              {p.layout === 'window' ? (
                <div class="pi-window">
                  <div class="pi-bar"><i></i><i></i><i></i></div>
                  <img src={p.shots[0].src} width={p.shots[0].w} height={p.shots[0].h} alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                </div>
              ) : (
                <div class="pi-phones">
                  {p.shots.map((s) => (
                    <div class="pi-phone"><img src={s.src} width={s.w} height={s.h} alt="" loading="lazy" decoding="async" /></div>
                  ))}
                </div>
              )}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="shell"><ContactBanner /></div>
</BaseLayout>

<style is:global>
  /* Product cards keep each product's own colours and display face; everything around them uses the site's tokens. */
  .pi-list{list-style:none;margin:0;padding:0 0 clamp(48px,7vw,88px);display:grid;gap:20px}
  .pi-item{transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1)}
  .pi-anim .pi-item:not(.in){opacity:0;transform:translateY(24px)}
  .pi-card{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);min-height:420px;overflow:hidden;text-decoration:none;background:var(--c-bg);color:var(--c-ink);border:1px solid var(--color-border-subtle);transition:transform .35s cubic-bezier(.2,.7,.2,1),border-color .3s ease}
  .pi-card:hover{transform:translateY(-3px);border-color:var(--color-border-strong)}
  .pi-card:focus-visible{outline:2px solid var(--color-accent);outline-offset:4px}
  .pi-copy{display:flex;flex-direction:column;padding:clamp(28px,4vw,48px)}
  .pi-kind{display:flex;gap:12px;margin:0;font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--c-muted)}
  .pi-kind span{color:var(--c-accent)}
  .pi-name{margin:auto 0 0;padding-top:36px;font-family:var(--c-font);font-size:clamp(40px,5vw,60px);line-height:1;letter-spacing:-.035em;font-weight:800}
  .pi-item[style*="Archivo"] .pi-name{font-stretch:118%}
  .pi-line{margin:14px 0 0;font-family:var(--c-font);font-size:clamp(19px,1.9vw,23px);line-height:1.25;letter-spacing:-.015em;font-weight:700}
  .pi-problem{margin:12px 0 0;max-width:44ch;color:var(--c-muted);font-size:15px;line-height:1.65}
  .pi-status{margin:20px 0 0;font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--c-muted)}
  .pi-go{display:inline-flex;align-self:flex-start;gap:8px;margin-top:22px;padding-bottom:4px;border-bottom:1px solid currentColor;color:var(--c-accent);font-weight:600;font-size:14px}
  .pi-arrow{transition:transform .25s ease}
  .pi-card:hover .pi-arrow{transform:translate(2px,-2px)}
  .pi-art{position:relative;overflow:hidden;display:flex;align-items:flex-end;justify-content:center;background:radial-gradient(120% 90% at 70% 100%,color-mix(in srgb,var(--c-accent) 16%,transparent),transparent 70%)}
  .pi-window{width:118%;margin:52px -18% -2px 0;align-self:flex-end;border-radius:12px 0 0 0;overflow:hidden;background:#fff;border:1px solid color-mix(in srgb,var(--c-ink) 12%,transparent);border-right:0;border-bottom:0;box-shadow:0 30px 60px -30px color-mix(in srgb,var(--c-ink) 50%,transparent);transition:transform .6s cubic-bezier(.2,.7,.2,1)}
  .pi-bar{display:flex;gap:6px;padding:10px 12px;background:#f3f4f2;border-bottom:1px solid #e3e4e0}
  .pi-bar i{width:10px;height:10px;border-radius:50%;background:#d6d8d3}
  .pi-window img{display:block;width:100%;height:auto}
  .pi-card:hover .pi-window{transform:translate(-8px,-6px)}
  .pi-phones{display:flex;align-items:flex-end;gap:18px;padding:44px 24px 0;height:100%}
  .pi-phone{width:min(200px,40%);border-radius:26px 26px 0 0;padding:8px 8px 0;background:#111;box-shadow:0 30px 60px -30px rgba(0,0,0,.6);transition:transform .6s cubic-bezier(.2,.7,.2,1)}
  .pi-phone:nth-child(2){transform:translateY(32px)}
  .pi-phone img{display:block;width:100%;height:auto;max-height:360px;object-fit:cover;object-position:top;border-radius:19px 19px 0 0}
  .pi-card:hover .pi-phone:first-child{transform:translateY(-8px)}
  .pi-card:hover .pi-phone:nth-child(2){transform:translateY(20px)}
  @media (max-width:860px){
    .pi-card{grid-template-columns:1fr;min-height:0}
    .pi-name{padding-top:28px}
    .pi-art{min-height:250px}
    .pi-window{width:100%;margin:8px 0 -2px 24px}
    .pi-phones{padding-top:16px;justify-content:center}
    .pi-phone img{max-height:290px}
  }
  @media (prefers-reduced-motion:reduce){
    .pi-item,.pi-card,.pi-window,.pi-phone,.pi-arrow{transition:none}
    .pi-anim .pi-item:not(.in){opacity:1;transform:none}
    .pi-card:hover,.pi-card:hover .pi-window,.pi-card:hover .pi-phone:first-child{transform:none}
    .pi-card:hover .pi-phone:nth-child(2){transform:translateY(32px)}
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>('.pi-item');
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.body.classList.add('pi-anim');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -10% 0px' });
    items.forEach((el) => io.observe(el));
  }
</script>
