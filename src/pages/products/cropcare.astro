<script>
  const root = document.documentElement;
  const motion = root.classList.contains('cc-motion');
  const hasIO = 'IntersectionObserver' in window;
  const outQuart = (t: number) => 1 - Math.pow(1 - t, 4);

  // Calls cb(true/false) as the element enters and leaves the viewport.
  function watch(el: Element, cb: (on: boolean) => void, threshold = 0, rootMargin = '0px') {
    if (!hasIO) { cb(true); return; }
    new IntersectionObserver(([e]) => cb(e.isIntersecting), { threshold, rootMargin }).observe(el);
  }

  // Sinhala and Tamil faces: fetched only when the language demo comes near (see `indicFonts`).
  const langSec = document.getElementById('languages');
  const indicHref = langSec?.dataset.indicFonts;
  if (indicHref && langSec) {
    let loaded = false;
    const load = () => {
      if (loaded) return;
      loaded = true;
      const l = document.createElement('link');
      l.rel = 'stylesheet';
      l.href = indicHref;
      document.head.appendChild(l);
    };
    if (hasIO) {
      const fio = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { load(); fio.disconnect(); } }, { rootMargin: '1200px 0px' });
      fio.observe(langSec);
    } else load();
  }

  // Tween a number in an element's text.
  function tween(el: HTMLElement, from: number, to: number, dec: number, dur: number, delay: number, suffix = '') {
    const t0 = performance.now() + delay;
    const run = (t: number) => {
      const p = Math.min(1, Math.max(0, (t - t0) / dur));
      el.textContent = (from + (to - from) * outQuart(p)).toFixed(dec) + suffix;
      if (p < 1) requestAnimationFrame(run);
    };
    requestAnimationFrame(run);
  }

  // Scroll reveals
  const rv = document.querySelectorAll<HTMLElement>('.cc-rv');
  if (hasIO) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('is-in');
        io.unobserve(e.target);
      });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.15 });
    rv.forEach((el) => io.observe(el));
  } else {
    rv.forEach((el) => el.classList.add('is-in'));
  }

  // Pause decorative loops while they're off screen.
  document.querySelectorAll('.cc-hero-stage, .cc-arch').forEach((el) => watch(el, (on) => el.classList.toggle('is-vis', on)));

  // HERO: aim, shutter, check, scan, then the result page opens and scrolls to its guidance; then back to aim. Pauses off screen.
  const dev = document.querySelector<HTMLElement>('.cc-hero-device');
  if (dev && motion) {
    const seq: [string, number][] = [['shot', 200], ['check', 360], ['scan', 700], ['result', 2600], ['guide', 3000], ['aim', 1500]];
    let i = -1;
    let timer: number | undefined;
    let running = false;
    let inView = true;
    const next = () => {
      i = (i + 1) % seq.length;
      const [phase, ms] = seq[i];
      dev.dataset.phase = phase;
      timer = window.setTimeout(next, ms);
    };
    const sync = () => {
      const go = inView && !document.hidden;
      if (go && !running) { running = true; timer = window.setTimeout(next, i < 0 ? 200 : 500); }
      if (!go && running) { running = false; window.clearTimeout(timer); }
    };
    watch(dev, (on) => { inView = on; sync(); }, 0.2);
    document.addEventListener('visibilitychange', sync);
  }

  // HOW IT WORKS: the active step is the last one whose top has passed the middle of the screen.
  const stepEls = Array.from(document.querySelectorAll<HTMLElement>('.cc-step'));
  const stepList = document.querySelector<HTMLElement>('.cc-steps');
  const howScreen = document.querySelector<HTMLElement>('.cc-how-screen');
  const howRes = howScreen?.querySelector<HTMLElement>('.cc-res');
  const howPort = howScreen?.querySelector<HTMLElement>('.cc-res-port');
  const howScroll = howScreen?.querySelector<HTMLElement>('.cc-res-scroll');
  const dots = document.querySelectorAll<HTMLElement>('[data-dot]');
  const howCount = document.querySelector<HTMLElement>('.cc-how-count b');
  const GUIDE_AT = 725 / 2149; // "Do this now" in result-scroll.webp
  let active = -1;
  const place = () => {
    if (!howScroll || !howPort || active < 0) return;
    const max = Math.max(0, howScroll.offsetHeight - howPort.offsetHeight);
    const y = active <= 1 ? 0 : active === 2 ? Math.min(max, howScroll.offsetHeight * GUIDE_AT) : max;
    howScroll.style.transform = `translate3d(0, ${-Math.round(y)}px, 0)`;
  };
  const setStep = (n: number) => {
    if (n === active) return;
    active = n;
    stepEls.forEach((s, k) => s.classList.toggle('is-on', k === n));
    dots.forEach((d, k) => { d.classList.toggle('is-on', k === n); d.classList.toggle('is-done', k < n); });
    if (howCount) howCount.textContent = String(n + 1).padStart(2, '0');
    if (howScreen) howScreen.dataset.step = String(n);
    if (howRes) howRes.dataset.focus = String(Math.max(1, n));
    if (stepList && stepEls.length > 1) {
      const span = stepEls[stepEls.length - 1].offsetTop - stepEls[0].offsetTop;
      stepList.style.setProperty('--rail-span', span + 'px');
      stepList.style.setProperty('--rail', String(span ? (stepEls[n].offsetTop - stepEls[0].offsetTop) / span : 0));
    }
    place();
  };
  if (stepEls.length) {
    let raf = 0;
    const update = () => {
      raf = 0;
      const line = window.innerHeight * 0.5;
      let n = 0;
      stepEls.forEach((s, k) => { if (s.getBoundingClientRect().top < line) n = k; });
      setStep(n);
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(update); };
    update();
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', () => { const a = active; active = -1; setStep(Math.max(0, a)); queue(); });
    howScroll?.querySelector('img')?.addEventListener('load', place);
  }

  // Segmented controls that play through their options once while visible (motion only).
  // Hovering or focusing the demo pauses it; choosing an option stops it for good.
  function segmented(el: HTMLElement, attr: string, values: string[], period: number, onApply?: (v: string) => void) {
    const btns = el.querySelectorAll<HTMLButtonElement>('[data-set]');
    let idx = Math.max(0, values.indexOf(el.getAttribute(attr) || ''));
    let timer: number | undefined;
    let done = !motion;
    let inView = false;
    let hold = false;
    let steps = 0;
    el.style.setProperty('--period', period + 'ms');
    const apply = (v: string) => {
      if (el.getAttribute(attr) === v) return;
      el.setAttribute(attr, v);
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.set === v)));
      onApply?.(v);
    };
    const stop = () => { window.clearTimeout(timer); timer = undefined; el.classList.remove('is-auto'); };
    const schedule = () => {
      stop();
      if (done || !inView || hold) return;
      void el.offsetWidth;
      el.classList.add('is-auto');
      timer = window.setTimeout(() => {
        idx = (idx + 1) % values.length;
        apply(values[idx]);
        steps += 1;
        if (steps >= values.length) { done = true; stop(); } else schedule();
      }, period);
    };
    btns.forEach((b) => b.addEventListener('click', () => {
      done = true;
      stop();
      idx = values.indexOf(b.dataset.set!);
      apply(b.dataset.set!);
    }));
    if (done) return;
    el.addEventListener('pointerenter', () => { hold = true; schedule(); });
    el.addEventListener('pointerleave', () => { hold = el.contains(document.activeElement); schedule(); });
    el.addEventListener('focusin', () => { hold = true; schedule(); });
    el.addEventListener('focusout', (e) => { if (!el.contains(e.relatedTarget as Node)) { hold = el.matches(':hover'); schedule(); } });
    watch(el, (on) => { inView = on; schedule(); }, 0.5);
  }

  const meter = document.querySelector<HTMLElement>('.cc-meter');
  if (meter) {
    const vals = meter.querySelectorAll<HTMLElement>('.cc-bar-val');
    segmented(meter, 'data-mode', ['spread', 'clear'], 4200, (mode) => {
      vals.forEach((v, k) => {
        const to = Number(mode === 'clear' ? v.dataset.clear : v.dataset.spread);
        const from = parseFloat(v.textContent || '0');
        if (motion) tween(v, from, to, 0, 800, k * 70, '%');
        else v.textContent = to + '%';
      });
    });
  }
  const lang = document.querySelector<HTMLElement>('.cc-lang-demo');
  if (lang) segmented(lang, 'data-lang', ['en', 'si', 'ta'], 3800);

  // Signal switch
  const arch = document.querySelector<HTMLElement>('.cc-arch');
  const sw = arch?.querySelector<HTMLButtonElement>('.cc-switch');
  const swMsg = arch?.querySelector<HTMLElement>('[data-signal-msg]');
  sw?.addEventListener('click', () => {
    const on = arch!.dataset.signal !== 'on';
    arch!.dataset.signal = on ? 'on' : 'off';
    sw.setAttribute('aria-checked', String(on));
    sw.classList.remove('is-hint');
    if (swMsg) swMsg.textContent = on
      ? 'Signal on. The AI recommendation, follow-up chat and sync are available when you ask.'
      : 'Signal off. Photo checks, the model, built-in guidance and history keep working. The AI recommendation and chat wait for a connection, and sync changes wait in a queue.';
  });

  // The screen gallery scrolls sideways on small screens: only then is it a keyboard stop.
  const gallery = document.querySelector<HTMLElement>('.cc-gallery');
  if (gallery) {
    const sync = () => {
      if (gallery.scrollWidth > gallery.clientWidth + 2) gallery.tabIndex = 0;
      else gallery.removeAttribute('tabindex');
    };
    sync();
    window.addEventListener('resize', sync);
  }
  if (sw && motion) {
    let hinted = false;
    watch(sw, (on) => { if (on && !hinted) { hinted = true; sw.classList.add('is-hint'); } }, 1, '0px 0px -25% 0px');
  }
</script>
