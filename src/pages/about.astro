---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const platforms = [
  {
    name: 'GitHub',
    description: 'Repositories, open-source projects & commit activity',
    href: 'https://github.com/raashidarq',
    tag: '@raashidarq',
    iconType: 'github',
    hoverBorder: 'hover:border-fg/40',
    hoverText: 'group-hover:text-fg',
    iconColor: 'text-fg-secondary group-hover:text-fg group-hover:bg-fg/10',
    tagClass: 'text-fg-secondary bg-fg/5 border-border-subtle group-hover:border-fg/30',
  },
  {
    name: 'LinkedIn',
    description: 'Professional experience, recommendations & networking',
    href: 'https://linkedin.com/in/raashid-arquil',
    tag: 'raashid-arquil',
    iconType: 'linkedin',
    hoverBorder: 'hover:border-[#0A66C2]/40',
    hoverText: 'group-hover:text-[#0A66C2] dark:group-hover:text-[#378fe9]',
    iconColor: 'text-[#0A66C2] dark:text-[#378fe9] group-hover:bg-[#0A66C2]/10',
    tagClass: 'text-[#0A66C2] dark:text-[#378fe9] bg-[#0A66C2]/10 border-[#0A66C2]/20',
  },
  {
    name: 'Twitter / X',
    description: 'Engineering notes, technical updates & discussions',
    href: 'https://x.com/raashidarq',
    tag: '@raashidarq',
    iconType: 'twitter',
    hoverBorder: 'hover:border-[#1DA1F2]/40 dark:hover:border-[#1d9bf0]/40',
    hoverText: 'group-hover:text-[#1DA1F2] dark:group-hover:text-[#1d9bf0]',
    iconColor: 'text-[#1DA1F2] dark:text-[#1d9bf0] group-hover:bg-[#1DA1F2]/10',
    tagClass: 'text-[#1DA1F2] dark:text-[#1d9bf0] bg-[#1DA1F2]/10 border-[#1DA1F2]/20',
  },
  {
    name: 'LeetCode',
    description: 'Data structures & algorithm problem-solving practice',
    href: 'https://leetcode.com/u/Rvvshid04/',
    tag: 'Rvvshid04',
    iconType: 'leetcode',
    hoverBorder: 'hover:border-[#FFA116]/40',
    hoverText: 'group-hover:text-[#FFA116]',
    iconColor: 'text-[#FFA116] group-hover:bg-[#FFA116]/10',
    tagClass: 'text-[#FFA116] bg-[#FFA116]/10 border-[#FFA116]/20',
  },
  {
    name: 'HackerRank',
    description: 'Problem-solving, Python & SQL assessment badges',
    href: 'https://www.hackerrank.com/profile/raashid_arq',
    tag: 'raashid_arq',
    iconType: 'hackerrank',
    hoverBorder: 'hover:border-[#2EC866]/40',
    hoverText: 'group-hover:text-[#2EC866] dark:group-hover:text-[#00EA64]',
    iconColor: 'text-[#2EC866] dark:text-[#00EA64] group-hover:bg-[#2EC866]/10',
    tagClass: 'text-[#2EC866] dark:text-[#00EA64] bg-[#2EC866]/10 border-[#2EC866]/20',
  },
];

const certifications = [
  {
    title: 'Postman API Fundamentals Student Expert',
    issuer: 'Postman',
    date: '2025',
    tag: 'REST API Testing & Architecture',
  },
];
---

<BaseLayout
  title="About & Background | Raashid Arquil"
  description="Background, education, engineering approach, and verified profiles of software developer Raashid Arquil."
>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 pt-4 sm:pt-8 pb-16 space-y-12">
    <!-- Header -->
    <header class="max-w-reading space-y-3">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-fg tracking-tight">
        About Me
      </h1>
      <p class="text-base sm:text-lg text-fg-secondary leading-relaxed">
        Software developer focused on building reliable mobile applications, applied on-device machine learning, and clean backend services.
      </p>
    </header>

    <!-- Unified Profile & Key Facts Card -->
    <section class="p-6 sm:p-8 rounded-2xl bg-bg-surface border border-border-subtle hover:border-accent/40 hover:shadow-lg dark:hover:shadow-[0_8px_30px_rgba(59,130,246,0.08)] transition-all duration-300 shadow-sm">
      <div class="flex flex-col md:flex-row items-center gap-6 sm:gap-8">
        <!-- Portrait -->
        <div class="w-36 h-36 sm:w-44 sm:h-44 rounded-2xl overflow-hidden border border-border-strong flex-shrink-0 shadow-md">
          <img
            src="/images/profile.jpg"
            alt="Portrait of Raashid Arquil"
            class="w-full h-full object-cover object-center transition-transform duration-300 hover:scale-105"
          />
        </div>

        <!-- Bio & Actions -->
        <div class="space-y-4 flex-1 text-center md:text-left">
          <div>
            <h2 class="text-2xl font-bold text-fg tracking-tight">Raashid Arquil</h2>
            <p class="text-sm font-medium text-accent">Software Developer · Kandy, Sri Lanka</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-fg-secondary font-mono">
            <div class="p-2.5 rounded-lg bg-bg-elevated/50 border border-border-subtle/70 text-left hover:border-accent/30 hover:bg-bg-elevated transition-all">
              <span class="text-fg-muted block text-[10px] uppercase">Degree</span>
              <strong class="text-fg font-sans font-semibold">B.Sc. (Hons) in Computer Science</strong> (First-Class)
            </div>
            <div class="p-2.5 rounded-lg bg-bg-elevated/50 border border-border-subtle/70 text-left hover:border-accent/30 hover:bg-bg-elevated transition-all">
              <span class="text-fg-muted block text-[10px] uppercase">Institution</span>
              <strong class="text-fg font-sans font-semibold">Kingston University</strong> (2025)
            </div>
            <div class="p-2.5 rounded-lg bg-bg-elevated/50 border border-border-subtle/70 text-left hover:border-accent/30 hover:bg-bg-elevated transition-all">
              <span class="text-fg-muted block text-[10px] uppercase">Marketing Qualification</span>
              <strong class="text-fg font-sans font-semibold">Level 7 Postgraduate Diploma</strong> (CIM, Merit)
            </div>
            <div class="p-2.5 rounded-lg bg-bg-elevated/50 border border-border-subtle/70 text-left hover:border-accent/30 hover:bg-bg-elevated transition-all">
              <span class="text-fg-muted block text-[10px] uppercase">Active Learning</span>
              <strong class="text-fg font-sans font-semibold">Ascentic AI Launchpad</strong> (Mobile & Applied AI)
            </div>
          </div>

          <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 pt-2">
            <a
              href="/resume.pdf"
              download
              class="btn-glow inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-semibold bg-fg text-bg-surface hover:opacity-90 transition-all shadow-sm active:scale-95"
            >
              <span>Download Resume (PDF)</span>
              <span>↓</span>
            </a>
            <a
              href="mailto:raashid.arq@gmail.com"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-medium text-fg-secondary hover:text-fg hover:bg-bg-elevated border border-border-subtle hover:border-accent/40 transition-colors"
            >
              <span>raashid.arq@gmail.com</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Narrative Section -->
    <section class="max-w-reading space-y-6 text-base text-fg-secondary leading-relaxed">
      <h2 class="text-2xl font-bold text-fg tracking-tight border-b border-border-subtle pb-3">
        Background & Approach
      </h2>
      <p>
        With a background in Computer Science from <strong class="text-fg font-semibold">Kingston University</strong>, my experience spans building full-stack web applications and mobile architectures—covering role-based access control, database schema design, and secure payment integrations.
      </p>
      <p>
        I am currently focused on mobile systems and applied machine learning. My primary project is <strong class="text-fg font-semibold">CropCare</strong> — an offline-first agricultural diagnostic application running on-device MobileNetV3 models via TensorFlow Lite, with local Drift SQLite storage and background synchronization with FastAPI and Gemini AI.
      </p>
      <p>
        Holding a Level 7 Postgraduate Diploma in Professional Marketing from the Chartered Institute of Marketing (CIM), I combine technical architecture with user empathy, structured problem-solving, and clear communication.
      </p>
    </section>

    <!-- Verified Platforms & Profiles -->
    <section class="space-y-6">
      <div class="border-b border-border-subtle pb-3">
        <h2 class="text-2xl font-bold text-fg tracking-tight">
          Verified Developer Profiles
        </h2>
        <p class="text-sm text-fg-secondary mt-1">
          Platforms where I maintain code, practice algorithms, and share technical work.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          platforms.map((p) => (
            <a
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
              class={`group p-5 rounded-xl bg-bg-surface border border-border-subtle ${p.hoverBorder} transition-all duration-200 hover:shadow-md flex flex-col justify-between space-y-4`}
            >
              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2.5">
                    <div class={`w-8 h-8 rounded-lg bg-bg-elevated border border-border-subtle flex items-center justify-center ${p.iconColor} transition-all duration-200`}>
                      {p.iconType === 'github' && (
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
                        </svg>
                      )}
                      {p.iconType === 'linkedin' && (
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.6 1.6 0 1 0-.04-3.2 1.6 1.6 0 0 0 .04 3.2m1.39 9.74v-8.37H5.07v8.37h2.78z"/>
                        </svg>
                      )}
                      {p.iconType === 'twitter' && (
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                        </svg>
                      )}
                      {p.iconType === 'leetcode' && (
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M13.483 0a1.374 1.374 0 0 0-.961.438L7.116 6.226l-3.854 4.126a5.266 5.266 0 0 0-1.209 2.104 5.35 5.35 0 0 0-.125.513 5.527 5.527 0 0 0 .062 2.362 5.83 5.83 0 0 0 .349 1.017 5.938 5.938 0 0 0 1.271 1.818l4.277 4.193.039.038c2.248 2.165 5.852 2.133 8.063-.074l2.396-2.392c.54-.54.54-1.414.003-1.955a1.378 1.378 0 0 0-1.951-.003l-2.396 2.392a3.021 3.021 0 0 1-4.205.038l-.02-.019-4.276-4.193c-.652-.64-.972-1.469-.948-2.263a2.68 2.68 0 0 1 .666-1.607 2.6 2.6 0 0 1 .616-.546l3.708-3.965 4.91-5.304A1.377 1.377 0 0 0 13.483 0zm-2.88 8.42a1.38 1.38 0 0 0-.978.404l-4.9 4.9a1.377 1.377 0 0 0 0 1.95 1.378 1.378 0 0 0 1.95 0l4.9-4.9a1.378 1.378 0 0 0-.972-2.354zm7.986 4.316h-7.61a1.38 1.38 0 1 0 0 2.76h7.61a1.38 1.38 0 1 0 0-2.76z"/>
                        </svg>
                      )}
                      {p.iconType === 'hackerrank' && (
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm1.758 16.697h-1.424v-3.793h-2.668v3.793H8.242V7.303h1.424v3.834h2.668V7.303h1.424v9.394z"/>
                        </svg>
                      )}
                    </div>
                    <h3 class={`font-bold text-fg ${p.hoverText} transition-colors`}>
                      {p.name}
                    </h3>
                  </div>
                  <span class={`text-fg-muted ${p.hoverText} transition-colors text-sm`}>
                    ↗
                  </span>
                </div>
                <p class="text-xs text-fg-muted leading-relaxed">{p.description}</p>
              </div>
              <span class={`text-[11px] font-mono px-2 py-0.5 rounded w-fit border font-medium ${p.tagClass}`}>
                {p.tag}
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Certifications -->
    <section class="space-y-4">
      <div class="border-b border-border-subtle pb-3">
        <h2 class="text-2xl font-bold text-fg tracking-tight">
          Certifications & Credentials
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          certifications.map((cert) => (
            <div class="group p-5 rounded-xl bg-bg-surface border border-border-subtle hover:border-[#FF6C37]/40 transition-colors space-y-3 shadow-sm">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-[#FF6C37] inline-block"></span>
                  <span class="text-xs font-mono font-bold text-[#FF6C37] tracking-wide">{cert.issuer}</span>
                </div>
                <span class="text-xs font-mono text-fg-muted">{cert.date}</span>
              </div>
              <h3 class="font-bold text-fg text-base">{cert.title}</h3>
              <div>
                <span class="inline-block text-[11px] font-mono font-medium px-2.5 py-0.5 rounded bg-[#FF6C37]/10 text-[#FF6C37] border border-[#FF6C37]/25">
                  {cert.tag}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Direct Contact Banner -->
    <section class="p-6 sm:p-8 rounded-2xl bg-bg-surface border border-border-subtle hover:border-accent/30 transition-colors flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="space-y-1 text-center sm:text-left">
        <h3 class="text-lg font-bold text-fg">Looking for engineering collaboration?</h3>
        <p class="text-xs text-fg-secondary">Open to full-time roles, software contracts, and discussions on mobile & AI systems.</p>
      </div>
      <a
        href="mailto:raashid.arq@gmail.com"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-xs font-semibold bg-accent text-white hover:bg-accent-hover transition-colors shadow-sm flex-shrink-0"
      >
        <span>Get in Touch</span>
        <span>→</span>
      </a>
    </section>
  </div>
</BaseLayout>
