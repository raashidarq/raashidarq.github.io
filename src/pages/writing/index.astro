---
// src/pages/writing/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('writing', ({ data }) => !data.draft);
const sortedArticles = allArticles.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Collect all unique tags
const allTags = Array.from(
  new Set(sortedArticles.flatMap((article) => article.data.tags || []))
).sort();
---

<BaseLayout
  title="Technical Writing & Architecture Notes | Raashid Arquil"
  description="Articles, architectural decision records, and development logs on mobile systems, on-device machine learning, and software engineering by Raashid Arquil."
>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-10">
    <!-- Header -->
    <header class="max-w-reading space-y-4">
      <div class="flex items-center justify-between gap-4">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded text-xs font-mono font-medium bg-bg-elevated text-fg-muted border border-border-subtle">
          Technical Writing
        </div>
        <a
          href="/rss.xml"
          class="inline-flex items-center gap-1 text-xs font-mono font-medium text-purple-600 dark:text-purple-400 hover:underline"
        >
          <span>RSS Feed</span>
          <span>↗</span>
        </a>
      </div>

      <h1 class="text-4xl sm:text-5xl font-extrabold text-fg tracking-tight">
        Articles & Engineering Notes
      </h1>
      <p class="text-base sm:text-lg text-fg-secondary leading-relaxed">
        Technical notes, architectural decision records, and development logs.
      </p>
    </header>

    <!-- Tag Filter Bar -->
    <div class="max-w-reading">
      <div class="flex items-center gap-2 flex-wrap text-xs font-mono">
        <span class="text-fg-muted mr-1">Filter by tag:</span>
        <button
          type="button"
          data-filter="all"
          class="tag-filter-btn px-3 py-1 rounded-lg border border-purple-500 bg-purple-500/10 text-purple-600 dark:text-purple-300 font-medium transition-all"
        >
          All ({sortedArticles.length})
        </button>
        {
          allTags.map((tag) => {
            const count = sortedArticles.filter((a) => a.data.tags?.includes(tag)).length;
            return (
              <button
                type="button"
                data-filter={tag}
                class="tag-filter-btn px-2.5 py-1 rounded-lg border border-border-subtle bg-bg-surface text-fg-secondary hover:border-purple-500/40 hover:text-fg transition-all"
              >
                #{tag} <span class="opacity-60 text-[10px]">({count})</span>
              </button>
            );
          })
        }
      </div>
    </div>

    <!-- Articles List -->
    <section id="articles-container" class="max-w-reading space-y-6">
      {
        sortedArticles.length === 0 ? (
          <div class="p-8 rounded-xl bg-bg-surface border border-border-subtle text-center text-fg-muted text-sm">
            Articles in progress. Check back shortly or subscribe via RSS.
          </div>
        ) : (
          sortedArticles.map((article) => (
            <article
              data-tags={JSON.stringify(article.data.tags || [])}
              class="writing-card group p-6 sm:p-7 rounded-xl bg-bg-surface border border-border-subtle hover:border-purple-500/30 transition-all duration-200 hover:shadow-md"
            >
              <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono text-fg-muted mb-3">
                <div class="flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded text-[11px] font-mono font-medium bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20">
                    AI Generated Placeholder
                  </span>
                  <span>·</span>
                  <time datetime={article.data.date}>{article.data.date}</time>
                  <span>·</span>
                  <span>{article.data.readingTime}</span>
                </div>
                <div class="flex flex-wrap gap-1">
                  {article.data.tags.map((tag) => (
                    <span class="px-2 py-0.5 rounded bg-bg-elevated text-fg-secondary text-[11px] border border-border-subtle">
                      #{tag}
                    </span>
                  ))}
                </div>
              </div>

              <h2 class="text-xl sm:text-2xl font-bold text-fg group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
                <a href={`/writing/${article.id}`} class="focus:outline-none">
                  {article.data.title}
                </a>
              </h2>

              <p class="mt-3 text-sm text-fg-secondary leading-relaxed">
                {article.data.description}
              </p>

              <div class="mt-5 pt-4 border-t border-border-subtle flex items-center text-xs font-medium text-purple-600 dark:text-purple-400">
                <span>Read Article</span>
                <span class="ml-1 transition-transform group-hover:translate-x-1">→</span>
              </div>
            </article>
          ))
        )
      }

      <div id="no-filter-match" class="hidden p-8 rounded-xl bg-bg-surface border border-border-subtle text-center text-fg-muted text-sm space-y-2">
        <p>No articles found matching the selected tag.</p>
        <button
          type="button"
          id="reset-filter-btn"
          class="text-xs font-mono text-purple-600 dark:text-purple-400 underline hover:no-underline"
        >
          Reset to all articles
        </button>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  function setupTagFilter() {
    const buttons = document.querySelectorAll('.tag-filter-btn');
    const articles = document.querySelectorAll('.writing-card');
    const noMatch = document.getElementById('no-filter-match');
    const resetBtn = document.getElementById('reset-filter-btn');

    if (!buttons.length || !articles.length) return;

    function applyFilter(selectedTag) {
      let visibleCount = 0;

      buttons.forEach((btn) => {
        const isMatch = btn.getAttribute('data-filter') === selectedTag;
        if (isMatch) {
          btn.className = 'tag-filter-btn px-3 py-1 rounded-lg border border-purple-500 bg-purple-500/10 text-purple-600 dark:text-purple-300 font-medium transition-all';
        } else {
          btn.className = 'tag-filter-btn px-2.5 py-1 rounded-lg border border-border-subtle bg-bg-surface text-fg-secondary hover:border-purple-500/40 hover:text-fg transition-all';
        }
      });

      articles.forEach((card) => {
        const rawTags = card.getAttribute('data-tags');
        const tags = rawTags ? JSON.parse(rawTags) : [];
        if (selectedTag === 'all' || tags.includes(selectedTag)) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (noMatch) {
        noMatch.classList.toggle('hidden', visibleCount > 0);
      }
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-filter') || 'all';
        applyFilter(tag);
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => applyFilter('all'));
    }
  }

  setupTagFilter();
  document.addEventListener('astro:after-swap', setupTagFilter);
</script>
