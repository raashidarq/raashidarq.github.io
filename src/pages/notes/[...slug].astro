---
import OptimizedImage from '../../components/OptimizedImage.astro';
import {getCollection,render} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths(){return (await getCollection('notes')).map(post=>({params:{slug:post.id},props:{post}}));}
const {post}=Astro.props;
const {Content}=await render(post);
---
<BaseLayout title={`${post.data.title} — Notes by Raashid Arquil`} description={post.data.description} type="article" articleDate={post.data.date} noindex={post.data.preview} image={post.data.image}>
<div class="shell notes-shell">
<header class="page-intro compact-intro"><a class="text-link" href="/notes">← Notes</a><p class="eyebrow mt-8">{post.data.topic} / {post.data.readingTime}</p><h1 class="note-title">{post.data.title}</h1><p class="lead">{post.data.description}</p>{post.data.date&&<time datetime={post.data.date}>{post.data.date}</time>}</header>
{post.data.preview&&<p class="preview-notice">Preview · Adapted from my LinkedIn post.</p>}
{post.data.image&&<figure class="note-photo"><OptimizedImage src={post.data.image} alt="Raashid presenting CropCare at Ascentic's AI Launchpad event at TRACE" width="2400" height="3600"/><figcaption>Presenting CropCare at TRACE, Sri Lanka.</figcaption></figure>}
<article class="article-body note-body"><Content/></article>
{post.data.sourceUrl&&<p class="note-source"><a class="text-link" href={post.data.sourceUrl} target="_blank" rel="noopener noreferrer">Original post on LinkedIn ↗</a></p>}
<div class="note-end"><a class="text-link" href="/notes">All notes ↗</a><a class="text-link" href="/contact">Continue the conversation ↗</a></div>
</div></BaseLayout>
