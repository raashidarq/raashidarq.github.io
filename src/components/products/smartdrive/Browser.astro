---
// Browser-window frame around a real SmartDrive screenshot (fictional demo data).
// Desktop captures are 1600×1003 (1280×802 CSS px at 1.25x). Below 640px a phone-width
// capture of the same screen is served instead (390×700 CSS px at 2x), so text stays legible.
interface Props {
  shot: 'student' | 'instructor' | 'admin' | 'book' | 'journey';
  alt: string;
  url?: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}
const { shot, alt, url = 'smartdrive / demo', eager = false, sizes = '(min-width: 1200px) 760px, 92vw', class: cls = '' } = Astro.props;
const base = `/products/smartdrive/ui-${shot}`;
---
<figure class={`sd-browser ${cls}`}>
  <div class="sd-browser-bar" aria-hidden="true">
    <span class="sd-dots"><i></i><i></i><i></i></span>
    <span class="sd-url">{url}</span>
  </div>
  <picture>
    <source
      media="(max-width: 639px)"
      srcset={`${base}-m390.webp 390w, ${base}-m780.webp 780w`}
      sizes="calc(100vw - 40px)"
      width="780"
      height="1400"
    />
    <img
      src={`${base}-1600.webp`}
      srcset={`${base}-880.webp 880w, ${base}-1600.webp 1600w`}
      sizes={sizes}
      width="1600"
      height="1003"
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
    />
  </picture>
</figure>
