---
// src/components/FlagshipHero.astro
import StatusBadge from './StatusBadge.astro';
import TechPill from './TechPill.astro';

interface Props {
  project: {
    id: string;
    data: {
      title: string;
      shortDescription: string;
      status: 'concept' | 'in-development' | 'beta' | 'live' | 'archived';
      technologies: string[];
      role: string;
      category?: string;
      githubUrl?: string;
      liveUrl?: string;
      thumbnail?: string;
      architectureHighlights?: string[];
      problemSummary?: string;
      solutionSummary?: string;
    };
  };
}

const { project } = Astro.props;
const {
  title,
  shortDescription,
  status,
  technologies,
  githubUrl,
  liveUrl,
  architectureHighlights = [
    'On-device quantized ML inference (offline diagnostic engine)',
    'Flutter BLoC architecture for predictable state synchronization',
    'FastAPI backend with asynchronous image processing & Supabase persistence',
  ],
} = project.data;
---

<section class="relative rounded-2xl bg-bg-surface border border-border-subtle hover:border-accent/50 overflow-hidden shadow-md hover:shadow-xl dark:hover:shadow-[0_12px_40px_rgba(59,130,246,0.12)] transition-all duration-300">
  <!-- Subtle top animated accent line -->
  <div class="h-1 w-full bg-gradient-to-r from-accent via-emerald-400 to-accent animate-gradient-shift"></div>

  <div class="p-6 sm:p-10 lg:p-12">
    <!-- Header Meta: Flagship badge + Status -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
      <div class="flex items-center gap-2.5">
        <span class="px-2.5 py-0.5 rounded text-xs font-mono font-bold uppercase tracking-wider bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20 shadow-2xs">
          Flagship Project
        </span>
        <StatusBadge status={status} />
      </div>
      <span class="text-xs font-mono text-fg-muted">July 2026 – Present · Personal Project</span>
    </div>

    <!-- Main Content Area -->
    <div class="space-y-6 max-w-3xl">
      <div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-fg tracking-tight">
          {title}
        </h2>
        <p class="mt-3 text-base sm:text-lg text-fg-secondary leading-relaxed">
          {shortDescription}
        </p>
      </div>

      <!-- Architecture Highlights Box -->
      <div class="p-5 rounded-xl bg-bg-elevated/70 border border-border-subtle hover:border-border-strong transition-colors space-y-3">
        <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-fg-muted">
          Key Engineering Highlights
        </h3>
        <ul class="space-y-2 text-sm text-fg-secondary">
          {
            architectureHighlights.map((highlight) => (
              <li class="flex items-start gap-2.5">
                <span class="text-accent mt-0.5 font-bold">✓</span>
                <span>{highlight}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Tech Stack -->
      <div>
        <h4 class="text-xs font-mono uppercase tracking-wider text-fg-muted mb-2.5">Core Stack</h4>
        <div class="flex flex-wrap gap-1.5">
          {technologies.map((tech) => <TechPill name={tech} />)}
        </div>
      </div>

      <!-- CTA Action Row -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href={`/work/${project.id}`}
          class="btn-glow inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold bg-accent text-white hover:bg-accent-hover shadow-sm transition-all active:scale-95"
        >
          <span>View Full Technical Case Study</span>
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>

        {
          githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium text-fg-secondary hover:text-fg bg-bg-elevated hover:bg-bg-subtle border border-border-subtle hover:border-accent/40 hover:shadow-[0_0_15px_rgba(59,130,246,0.15)] hover:-translate-y-0.5 transition-all duration-200 shadow-sm"
              aria-label={`GitHub repository for ${title}`}
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
              </svg>
              <span>GitHub</span>
            </a>
          )
        }

        {
          liveUrl && (
            <a
              href={liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium text-fg-secondary hover:text-fg bg-bg-elevated hover:bg-bg-subtle border border-border-subtle hover:border-accent/40 hover:shadow-[0_0_15px_rgba(59,130,246,0.15)] hover:-translate-y-0.5 transition-all duration-200 shadow-sm"
              aria-label={`Live demo for ${title}`}
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
              <span>Live Demo</span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
