---
// src/components/YouTubeEmbed.astro
interface Props {
  videoId: string;
  title?: string;
}

const { videoId, title = 'Project Video Presentation' } = Astro.props;
const posterUrl = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
---

<div
  class="relative w-full aspect-video rounded-xl overflow-hidden bg-bg-elevated border border-border-subtle group my-8"
  data-youtube-container={videoId}
>
  <button
    type="button"
    class="relative w-full h-full flex items-center justify-center cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
    aria-label={`Play video: ${title}`}
    onclick={`
      const container = this.parentElement;
      const id = container.getAttribute('data-youtube-container');
      container.innerHTML = '<iframe class="w-full h-full absolute inset-0 border-0" src="https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0" title="${title}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>';
    `}
  >
    <img
      src={posterUrl}
      alt={title}
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-102"
    />
    <div class="absolute inset-0 bg-black/40 group-hover:bg-black/30 transition-colors flex items-center justify-center">
      <div class="w-16 h-16 rounded-full bg-accent text-white flex items-center justify-center shadow-lg transform transition-transform group-hover:scale-110">
        <svg class="w-7 h-7 ml-1" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"></path>
        </svg>
      </div>
    </div>
    <span class="absolute bottom-3 left-4 text-xs font-mono text-white/90 bg-black/60 px-2.5 py-1 rounded backdrop-blur-sm">
      {title}
    </span>
  </button>
</div>
