---
// src/components/TechPill.astro
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<span
  class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono font-medium bg-bg-elevated text-fg-secondary border border-border-subtle hover:border-border-strong transition-colors"
>
  {name}
</span>
