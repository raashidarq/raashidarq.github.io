---
// src/components/TechPill.astro
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<span
  class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-mono font-medium bg-bg-elevated/70 text-fg-secondary border border-border-subtle hover:border-accent/40 hover:text-accent hover:bg-accent-muted hover:shadow-[0_0_10px_rgba(59,130,246,0.12)] hover:-translate-y-0.5 transition-all duration-200 cursor-default select-none"
>
  {name}
</span>
