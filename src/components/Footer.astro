---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border-subtle bg-bg-surface transition-colors">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      <!-- Col 1: Identity & Philosophy -->
      <div class="space-y-3">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg overflow-hidden bg-black p-0.5 border border-border-strong flex items-center justify-center">
            <img src="/images/logo.png" alt="Raashid Arquil Logo" class="w-full h-full object-contain brightness-125" />
          </div>
          <span class="font-bold text-fg text-sm tracking-tight">Raashid Arquil</span>
        </div>
        <p class="text-xs text-fg-muted leading-relaxed max-w-sm">
          Software developer focused on building practical, reliable applications across mobile, backend systems, and modern web architectures.
        </p>
      </div>

      <!-- Col 2: Navigation & Resources -->
      <div class="space-y-2">
        <h4 class="text-xs font-mono font-semibold uppercase tracking-wider text-fg-muted">Navigation</h4>
        <ul class="space-y-1.5 text-xs text-fg-secondary">
          <li><a href="/" class="hover:text-accent transition-colors">Home</a></li>
          <li><a href="/work" class="hover:text-accent transition-colors">Work & Case Studies</a></li>
          <li><a href="/writing" class="hover:text-accent transition-colors">Technical Writing</a></li>
          <li><a href="/about" class="hover:text-accent transition-colors">About & Background</a></li>
          <li><a href="/resume.pdf" download class="hover:text-accent transition-colors inline-flex items-center gap-1">Download Resume <span class="text-[10px] text-fg-muted">(PDF)</span></a></li>
        </ul>
      </div>

      <!-- Col 3: Connect & Feeds -->
      <div class="space-y-2">
        <h4 class="text-xs font-mono font-semibold uppercase tracking-wider text-fg-muted">Connect</h4>
        <ul class="space-y-1.5 text-xs text-fg-secondary">
          <li>
            <a href="https://github.com/raashidarq" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors inline-flex items-center gap-1">
              GitHub <span>↗</span>
            </a>
          </li>
          <li>
            <a href="https://linkedin.com/in/raashid-arquil" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors inline-flex items-center gap-1">
              LinkedIn <span>↗</span>
            </a>
          </li>
          <li>
            <a href="https://x.com/raashidarq" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors inline-flex items-center gap-1">
              Twitter / X <span>↗</span>
            </a>
          </li>
          <li>
            <a href="/rss.xml" class="hover:text-accent transition-colors inline-flex items-center gap-1">
              RSS Feed <span>↗</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-border-subtle flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-fg-muted">
      <p>© {currentYear} Raashid Arquil. All rights reserved.</p>
      <p class="font-mono text-[11px]">
        Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-fg hover:underline">Astro</a> · Static & Performance-First
      </p>
    </div>
  </div>
</footer>
