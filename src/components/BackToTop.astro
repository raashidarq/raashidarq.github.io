---
// src/components/BackToTop.astro
// A small "back to top" arrow that fades in once the reader is a screen or so down the page.
---
<nav class="btt-nav" aria-label="Back to top">
<a class="btt" href="#top" aria-label="Back to top" data-btt hidden>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
</a>
</nav>

<style is:global>
  a.btt[data-btt]{position:fixed;right:clamp(16px,3vw,28px);bottom:clamp(16px,3vw,28px);z-index:90;display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:#1d1f1c;color:#f5f2eb;box-shadow:0 8px 24px -10px rgba(0,0,0,.45);text-decoration:none;opacity:0;transform:translateY(10px);pointer-events:none;transition:opacity .25s ease,transform .25s ease,background .2s ease}
  .btt[hidden]{display:grid}
  .btt.is-visible{opacity:.92;transform:none;pointer-events:auto}
  .btt:hover{opacity:1;transform:translateY(-2px)}
  .btt svg{transition:transform .2s ease}
  .btt:hover svg{transform:translateY(-1px)}
  .btt:focus-visible{outline:3px solid #2559b0;outline-offset:3px;opacity:1}
  :root.dark a.btt[data-btt]{background:#f3efe6;color:#1b1c19}
  @media print{.btt{display:none}}
  @media (prefers-reduced-motion:reduce){.btt,.btt svg{transition:none}.btt:hover,.btt:hover svg{transform:none}}
</style>

<script>
  const btn = document.querySelector<HTMLAnchorElement>('[data-btt]');
  if (btn) {
    btn.hidden = false;
    const update = () => btn.classList.toggle('is-visible', window.scrollY > window.innerHeight * 0.9);
    window.addEventListener('scroll', update, { passive: true });
    update();
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      // Return keyboard focus to the start of the page.
      const start = document.querySelector<HTMLElement>('header a');
      start?.focus({ preventScroll: true });
      btn.blur();
    });
  }
</script>
