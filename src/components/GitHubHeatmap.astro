---
// src/components/GitHubHeatmap.astro
interface Props {
  username?: string;
}

const { username = 'raashidarq' } = Astro.props;

let rawSvg = '';
try {
  const res = await fetch(`https://ghchart.rshah.org/8b5cf6/${username}`);
  if (res.ok) {
    const text = await res.text();
    // Clean SVG and inject viewBox so the heatmap scales properly and fills the container
    rawSvg = text
      .replace(/<\?xml.*?\?>/i, '')
      .replace(/<!DOCTYPE.*?>/i, '')
      .replace(
        /<svg[^>]*>/i,
        '<svg viewBox="0 0 663 104" preserveAspectRatio="xMidYMid meet" class="w-full h-auto block" xmlns="http://www.w3.org/2000/svg">'
      );
  }
} catch (e) {
  rawSvg = '';
}
---

<section class="w-full p-6 sm:p-8 rounded-2xl bg-bg-surface border border-border-subtle hover:border-purple-500/30 transition-all shadow-sm space-y-4">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="space-y-0.5">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block animate-pulse"></span>
        <h2 class="text-xl font-bold text-fg tracking-tight">GitHub Activity Heatmap</h2>
      </div>
      <p class="text-xs text-fg-muted">
        Live contributions synchronized from <a href={`https://github.com/${username}`} target="_blank" rel="noopener noreferrer" class="text-purple-600 dark:text-purple-400 font-medium hover:underline">github.com/{username}</a>.
      </p>
    </div>

    <a
      href={`https://github.com/${username}`}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium bg-bg-elevated text-fg border border-border-subtle hover:border-purple-500/40 hover:text-purple-600 dark:hover:text-purple-400 transition-colors flex-shrink-0"
    >
      <span>@{username}</span>
      <span>↗</span>
    </a>
  </div>

  <!-- Heatmap Container - Scaled up and spanning full content width -->
  <div class="w-full overflow-x-auto pb-2 pt-1 scrollbar-thin">
    <div class="min-w-[720px] p-4 sm:p-6 rounded-xl bg-bg-elevated/40 dark:bg-bg-code/60 border border-border-subtle">
      {
        rawSvg ? (
          <div class="github-heatmap-svg w-full flex justify-center py-1" set:html={rawSvg} />
        ) : (
          <div id="client-heatmap-container" class="github-heatmap-svg w-full py-4 text-center">
            <span class="text-xs font-mono text-fg-muted">Loading live activity from GitHub...</span>
          </div>
        )
      }

      <!-- Custom Legend -->
      <div class="w-full flex items-center justify-between mt-4 pt-3 border-t border-border-subtle/50 text-xs font-mono text-fg-muted">
        <span>Less active</span>
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded-sm bg-[#e2e8f0] dark:bg-[#161c2e] border border-border-subtle inline-block" title="No contributions"></span>
          <span class="w-3 h-3 rounded-sm bg-[#c084fc] dark:bg-[#581c87] inline-block" title="Low"></span>
          <span class="w-3 h-3 rounded-sm bg-[#a855f7] dark:bg-[#7e22ce] inline-block" title="Medium"></span>
          <span class="w-3 h-3 rounded-sm bg-[#8b5cf6] dark:bg-[#a855f7] inline-block" title="High"></span>
          <span class="w-3 h-3 rounded-sm bg-[#7c3aed] dark:bg-[#c084fc] inline-block" title="Very high"></span>
        </div>
        <span>More active</span>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* SVG Heatmap theme adaptation & scaling */
  .github-heatmap-svg svg {
    width: 100% !important;
    height: auto !important;
    display: block;
    overflow: visible;
  }

  .github-heatmap-svg text {
    fill: var(--color-fg-muted) !important;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
    font-size: 9px !important;
  }

  /* Light Theme Squares */
  :root:not(.dark) .github-heatmap-svg rect[data-score="0"] {
    fill: #e2e8f0 !important;
    rx: 2.5px;
  }
  :root:not(.dark) .github-heatmap-svg rect[data-score="1"] {
    fill: #d8b4fe !important;
    rx: 2.5px;
  }
  :root:not(.dark) .github-heatmap-svg rect[data-score="2"] {
    fill: #a855f7 !important;
    rx: 2.5px;
  }
  :root:not(.dark) .github-heatmap-svg rect[data-score="3"] {
    fill: #8b5cf6 !important;
    rx: 2.5px;
  }
  :root:not(.dark) .github-heatmap-svg rect[data-score="4"] {
    fill: #7c3aed !important;
    rx: 2.5px;
  }

  /* Dark Theme Squares (Dark Charcoal & Luminous Purple) */
  .dark .github-heatmap-svg rect[data-score="0"] {
    fill: #161c2e !important;
    rx: 2.5px;
  }
  .dark .github-heatmap-svg rect[data-score="1"] {
    fill: #581c87 !important;
    rx: 2.5px;
  }
  .dark .github-heatmap-svg rect[data-score="2"] {
    fill: #7e22ce !important;
    rx: 2.5px;
  }
  .dark .github-heatmap-svg rect[data-score="3"] {
    fill: #a855f7 !important;
    rx: 2.5px;
  }
  .dark .github-heatmap-svg rect[data-score="4"] {
    fill: #c084fc !important;
    rx: 2.5px;
  }
</style>

<script is:inline define:vars={{ username }}>
  // Client-side fallback if SSR fetch was cached or empty
  async function loadClientHeatmap() {
    const container = document.getElementById('client-heatmap-container');
    if (!container) return;
    try {
      const res = await fetch(`https://ghchart.rshah.org/8b5cf6/${username}`);
      if (res.ok) {
        const text = await res.text();
        const cleaned = text
          .replace(/<\?xml.*?\?>/i, '')
          .replace(/<!DOCTYPE.*?>/i, '')
          .replace(
            /<svg[^>]*>/i,
            '<svg viewBox="0 0 663 104" preserveAspectRatio="xMidYMid meet" class="w-full h-auto block" xmlns="http://www.w3.org/2000/svg">'
          );
        container.innerHTML = cleaned;
      }
    } catch (e) {
      console.warn('Could not refresh GitHub heatmap client-side', e);
    }
  }
  loadClientHeatmap();
  document.addEventListener('astro:after-swap', loadClientHeatmap);
</script>
