---
// src/components/StatusBadge.astro
interface Props {
  status: 'concept' | 'in-development' | 'beta' | 'live' | 'archived';
  class?: string;
}

const { status, class: className = '' } = Astro.props;

const config = {
  live: {
    label: 'Live in Production',
    dotClass: 'bg-emerald-500',
    pulse: true,
    bgClass: 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border-emerald-500/20',
  },
  beta: {
    label: 'Beta Release',
    dotClass: 'bg-purple-500',
    pulse: true,
    bgClass: 'bg-purple-500/10 text-purple-700 dark:text-purple-300 border-purple-500/20',
  },
  'in-development': {
    label: 'In Active Development',
    dotClass: 'bg-blue-500',
    pulse: true,
    bgClass: 'bg-blue-500/10 text-blue-700 dark:text-blue-300 border-blue-500/20',
  },
  concept: {
    label: 'Concept / Planning',
    dotClass: 'bg-amber-500',
    pulse: false,
    bgClass: 'bg-amber-500/10 text-amber-700 dark:text-amber-300 border-amber-500/20',
  },
  archived: {
    label: 'Archived',
    dotClass: 'bg-slate-400',
    pulse: false,
    bgClass: 'bg-slate-500/10 text-slate-600 dark:text-slate-400 border-slate-500/20',
  },
}[status] || {
  label: status,
  dotClass: 'bg-slate-400',
  pulse: false,
  bgClass: 'bg-slate-500/10 text-slate-600 dark:text-slate-400 border-slate-500/20',
};
---

<span
  class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium border ${config.bgClass} ${className}`}
>
  <span class="relative flex h-1.5 w-1.5">
    {
      config.pulse && (
        <span
          class={`animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 ${config.dotClass}`}
        />
      )
    }
    <span class={`relative inline-flex rounded-full h-1.5 w-1.5 ${config.dotClass}`}></span>
  </span>
  <span>{config.label}</span>
</span>
