---
import ScreenComposition from './ScreenComposition.astro';
import OptimizedImage from './OptimizedImage.astro';
const keepScreens=[{url:'/images/keepclose-profile.png',alt:'',width:720,height:1600},{url:'/images/keepclose-memory.png',alt:'',width:720,height:1600}];
const cropScreens=[{url:'/images/cropcare-home.png',alt:'',width:600,height:1263},{url:'/images/cropcare-language.png',alt:'',width:600,height:1263}];
const smartScreens=[{url:'/images/smartdrive-instructor-new.jpg',alt:'SmartDrive instructor demo interface',width:1434,height:992},{url:'/images/smartdrive-student-new.jpg',alt:'SmartDrive student demo interface',width:1434,height:992},{url:'/images/smartdrive-admin.jpg',alt:'SmartDrive administrator demo interface',width:1434,height:992}];
interface Props{kind:'keepclose'|'cropcare'|'smartdrive'|'tally';}
const {kind}=Astro.props;
// Each cover is set in its product page's own typefaces.
const coverFonts='https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@125,800&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,800;1,700&family=Geist:wght@400;500;700&family=Noto+Sans:wght@400;500;700&family=Noto+Sans+Display:wght@800&display=swap';
---
<link rel="stylesheet" href={coverFonts}/>
{kind==='tally'?<div class="product-cover tally-cover"><div class="cover-top"><span>Independent product</span><span>Desktop / Offline</span></div><div class="tally-word">Tally<span>.</span></div><div class="cover-bottom">Habits. Focus. Tasks. Reflection.<br/>All on your own device.</div><div class="tally-window" aria-hidden="true"><div class="tally-window-bar"><i></i><i></i><i></i></div><img src="/images/tally/tally-today-dark-1x.png" alt="" width="1440" height="900" loading="lazy"/></div></div>:kind==='keepclose'?<div class="product-cover keepclose-cover">
<div class="cover-top">
<span>Independent product</span>
<span>Android / Offline</span>
</div>
<div class="keepclose-word">Keep<span>Close.</span>
</div>
<div class="cover-bottom">People. Relationships.<br/>The details worth remembering.</div>
<div class="cover-orbit" aria-hidden="true">
</div>
<div class="cover-orbit second" aria-hidden="true">
</div>
<div class="cover-phones" aria-hidden="true">{keepScreens.map(i=><OptimizedImage src={i.url} alt="" width={i.width} height={i.height} sizes="160px" loading="lazy"/>)}</div>
</div>:kind==='smartdrive'?<div class="product-cover smartdrive-cover"><div class="cover-top"><span>Final-year project</span><span>Web / Prototype</span></div><div class="smart-cover-title">The school.<br/><em class="serif">In one place.</em></div><ScreenComposition items={smartScreens} layout="web" compact/></div>:<div class="product-cover cropcare-cover">
<div class="cover-top">
<span>Ascentic Launchpad</span>
<span>Mobile / Applied ML</span>
</div>
<div>
<div class="crop-title">CropCare</div>
<div class="serif">A closer look<br/>at crop health.</div>
</div>
<div class="cover-bottom">On-device classification.<br/>An application in development.</div>
<div class="crop-lines" aria-hidden="true">
</div>
<div class="cover-phones" aria-hidden="true">{cropScreens.map(i=><OptimizedImage src={i.url} alt="" width={i.width} height={i.height} sizes="160px" loading="lazy"/>)}</div>
</div>}
