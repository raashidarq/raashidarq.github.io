---
// src/components/TechStackGrid.astro
import TechPill from './TechPill.astro';

const skillCategories = [
  {
    category: 'Programming Languages',
    skills: ['JavaScript (ES6+)', 'TypeScript', 'Python', 'Dart', 'Java', 'PHP', 'C#', 'SQL', 'HTML5 & CSS3'],
  },
  {
    category: 'Mobile & Applied AI',
    skills: [
      'Flutter',
      'Dart BLoC / Cubit',
      'TensorFlow Lite',
      'MobileNetV3',
      'On-Device ML',
      'Google Gemini API',
      'NVIDIA NIM',
      'Text-to-Speech (TTS)',
    ],
  },
  {
    category: 'Frontend & UI Engineering',
    skills: ['React', 'Tailwind CSS', 'Vite', 'Bootstrap', 'Axios', 'Responsive Design', 'Astro'],
  },
  {
    category: 'Backend & APIs',
    skills: ['FastAPI', 'Node.js', 'Express.js', 'REST APIs', 'Supabase Auth (OTP)', 'PayPal SDK', 'Postman'],
  },
  {
    category: 'Databases & Storage',
    skills: ['PostgreSQL', 'Supabase', 'SQLite (Drift)', 'MySQL', 'MS SQL Server', 'Oracle DB (PL/SQL)'],
  },
  {
    category: 'DevOps & Tooling',
    skills: ['Git', 'GitHub', 'VS Code', 'NPM / Yarn', 'Vercel', 'Render', 'Excalidraw / Draw.io'],
  },
];
---

<section class="space-y-6">
  <div class="space-y-1 border-b border-border-subtle pb-4">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-accent inline-block"></span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-fg tracking-tight">
        Technical Stack & Capabilities
      </h2>
    </div>
    <p class="text-sm text-fg-secondary">
      Tools, frameworks, languages, and systems I actively build and practice with.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
    {
      skillCategories.map((group) => (
        <div class="p-5 sm:p-6 rounded-2xl bg-bg-surface border border-border-subtle hover:border-accent/40 hover:shadow-lg dark:hover:shadow-[0_8px_30px_rgba(59,130,246,0.08)] hover:-translate-y-0.5 transition-all duration-300 flex flex-col justify-between space-y-4 shadow-sm">
          <h3 class="font-bold text-fg text-base flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-accent inline-block shadow-[0_0_6px_rgba(59,130,246,0.6)]"></span>
            {group.category}
          </h3>

          <div class="space-y-2 pt-2.5 border-t border-border-subtle/50">
            <span class="text-[11px] font-mono uppercase tracking-wider text-fg-muted block font-medium">
              Technologies & Tools
            </span>
            <div class="flex flex-wrap gap-1.5">
              {group.skills.map((skill) => (
                <TechPill name={skill} />
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
