---
// src/layouts/BaseLayout.astro
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/editorial.css';
import '../styles/project-media.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  articleDate?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title = 'Raashid Arquil | Software Engineer',
  description = 'Web and mobile applications, independent products, and freelance services by software engineer Raashid Arquil.',
  image = '/images/portfolio-sharing-thumbnail.png',
  canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://raashidarq.github.io').href,
  articleDate,
  type = 'website',
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString() : 'https://raashidarq.github.io';
const fullImageUrl = new URL(image, siteUrl).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'BlogPosting' : (Astro.url.pathname === '/' || Astro.url.pathname.startsWith('/about') ? 'ProfilePage' : 'WebPage'),
  [Astro.url.pathname === "/" || Astro.url.pathname.startsWith("/about") ? "mainEntity" : "about"]: {
    '@type': 'Person',
    name: 'Raashid Arquil',
    url: siteUrl,
    jobTitle: 'Software Engineer',
    sameAs: [
      'https://github.com/raashidarq',
      'https://linkedin.com/in/raashid-arquil',
      'https://x.com/raashidarq',
    ],
  },
  ...(type === 'article' && {
    headline: title,
    description: description,
    datePublished: articleDate,
    author: {
      '@type': 'Person',
      name: 'Raashid Arquil',
    },
  }),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="canonical" href={canonicalUrl} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Raashid Arquil" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:site_name" content="Raashid Arquil" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@raashidarq" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- Fonts used by the editorial layout -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Prevent FOUC Theme Script -->
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', savedTheme === 'dark' || (!savedTheme && prefersDark));
      } catch {
        document.documentElement.classList.toggle('dark', window.matchMedia('(prefers-color-scheme: dark)').matches);
      }
    </script>
  </head>
  <body class="bg-bg text-fg min-h-screen flex flex-col antialiased selection:bg-accent-muted selection:text-fg relative">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Navbar />
    <main id="main-content" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
