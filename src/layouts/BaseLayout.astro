---
import BackToTop from '../components/BackToTop.astro';
// src/layouts/BaseLayout.astro
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/editorial.css';
import '../styles/project-media.css';
import '../styles/motion.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  articleDate?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** 'dark' makes dark the default when the visitor hasn't picked a theme. */
  defaultTheme?: 'system' | 'dark';
}

const {
  title = 'Raashid Arquil | Software Engineer',
  description = 'Web and mobile applications, independent products, and freelance services by software engineer Raashid Arquil.',
  image = '/images/portfolio-sharing-thumbnail.png',
  canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://raashidarq.github.io').href,
  articleDate,
  type = 'website',
  noindex = false,
  defaultTheme = 'system',
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString() : 'https://raashidarq.github.io';
const fullImageUrl = new URL(image, siteUrl).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'BlogPosting' : (Astro.url.pathname === '/' || Astro.url.pathname.startsWith('/about') ? 'ProfilePage' : 'WebPage'),
  [Astro.url.pathname === "/" || Astro.url.pathname.startsWith("/about") ? "mainEntity" : "about"]: {
    '@type': 'Person',
    name: 'Raashid Arquil',
    url: siteUrl,
    jobTitle: 'Software Engineer',
    sameAs: [
      'https://github.com/raashidarq',
      'https://linkedin.com/in/raashid-arquil',
      'https://x.com/raashidarq',
    ],
  },
  ...(type === 'article' && {
    headline: title,
    description: description,
    datePublished: articleDate,
    author: {
      '@type': 'Person',
      name: 'Raashid Arquil',
    },
  }),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {!noindex && <link rel="canonical" href={canonicalUrl} />}

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Raashid Arquil" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:site_name" content="Raashid Arquil" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@raashidarq" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- Fonts used by the editorial layout -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Prevent FOUC Theme Script -->
    <script is:inline define:vars={{ defaultTheme }}>
      try {
        const savedTheme = localStorage.getItem('theme');
        const prefersDark = defaultTheme === 'dark' || window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', savedTheme === 'dark' || (!savedTheme && prefersDark));
      } catch {
        document.documentElement.classList.toggle('dark', defaultTheme === 'dark' || window.matchMedia('(prefers-color-scheme: dark)').matches);
      }
    </script>
    <!-- Page transitions: wait for the main content before showing the new page -->
    <link rel="expect" href="#main-content" blocking="render" />
    <slot name="head" />
  </head>
  <body class="bg-bg text-fg min-h-screen flex flex-col antialiased selection:bg-accent-muted selection:text-fg relative">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Navbar />
    <main id="main-content" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <BackToTop />
    <script>
      // Scroll reveals and arrow nudges. Nothing is hidden unless this runs, and only content
      // below the fold is revealed, so nothing flashes on load. Off for reduced motion.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // Wrap a trailing arrow in links so it can nudge on hover.
      document.querySelectorAll<HTMLAnchorElement>('main a, footer a').forEach((a) => {
        const last = a.lastChild;
        if (last && last.nodeType === Node.TEXT_NODE) {
          const m = /\s*([→↗])\s*$/.exec(last.textContent || '');
          if (m) {
            last.textContent = (last.textContent || '').slice(0, m.index) + ' ';
            const s = document.createElement('span');
            s.className = m[1] === '↗' ? 'arw arw-up' : 'arw';
            s.setAttribute('aria-hidden', 'true');
            s.textContent = m[1];
            a.append(s);
          }
        }
      });
      if (!reduce && 'IntersectionObserver' in window) {
        const sel = '.section-heading, .section-title, .project-card, .home-note, .event-feature > *, .note-link, .archive-row, .offer, .process-grid > article, .revised-about .article-body > *, .contact-banner, .service-grid > *';
        const picked: HTMLElement[] = [];
        document.querySelectorAll<HTMLElement>(sel).forEach((el) => {
          if (picked.some((p) => p.contains(el))) return;
          if (el.closest('.product-cover')) return;
          picked.push(el);
        });
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px' });
        const fold = window.innerHeight * 0.92;
        picked.forEach((el) => {
          if (el.getBoundingClientRect().top < fold) return;
          const sibs = el.parentElement ? Array.from(el.parentElement.children).filter((c) => c.matches(sel)) : [];
          const i = Math.max(0, sibs.indexOf(el));
          if (i) el.style.setProperty('--rv-delay', `${Math.min(i, 3) * 80}ms`);
          el.classList.add('rv');
          io.observe(el);
        });
        document.documentElement.classList.add('rv-on');
      }
    </script>
    <Footer />
  </body>
</html>
